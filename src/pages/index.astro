---
import SiteLayout from "../layouts/SiteLayout.astro";
import HeroDemo from "../components/product/HeroDemo.astro";
import ProductShowcase from "../components/product/ProductShowcase.astro";
import FollowUpDemo from "../components/product/FollowUpDemo.astro";
import HumanizedAIDemo from "../components/product/HumanizedAIDemo.astro";

const whatsappUrl =
  "https://wa.me/5548998493150?text=Ol%C3%A1%2C%20Daniel.%20Quero%20entender%20como%20essa%20opera%C3%A7%C3%A3o%20pode%20funcionar%20na%20minha%20empresa.";

const navItems = [
  ["Todos os canais", "#canais"],
  ["Como funciona", "#produto"],
  ["Rodízio", "#distribuicao"],
  ["Follow-up", "#follow-up"],
  ["Implantação", "#implantacao"],
] as const;

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Daniel Junior | Automação com IA",
  url: "https://danieljunior.com.br/",
  description:
    "Implantação e acompanhamento de atendimento com inteligência artificial, CRM, Kanban, distribuição de conversas e follow-up.",
  areaServed: "BR",
  founder: { "@type": "Person", name: "Daniel Junior" },
};
---

<SiteLayout
  title="Daniel Junior | Inteligência Artificial no WhatsApp"
  description="Inteligência artificial para atender clientes, organizar o CRM, distribuir conversas entre vendedores e fazer follow-up."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

  <header class="site-header" data-header>
    <div class="shell header-inner">
      <a class="brand" href="#inicio">
        <span class="brand-mark" aria-hidden="true">✦</span>
        <span class="brand-copy"><strong>Daniel Junior</strong><small>Automação com IA</small></span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span class="sr-only">Abrir menu</span><i></i><i></i>
      </button>

      <nav id="main-nav" class="main-nav" aria-label="Navegação principal">
        {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>

      <a class="nav-cta" href={whatsappUrl} target="_blank" rel="noreferrer">Falar sobre minha operação <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main id="conteudo">
    <section id="inicio" class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-light hero-light-one" aria-hidden="true"></div>
      <div class="hero-light hero-light-two" aria-hidden="true"></div>

      <div class="shell hero-copy">
        <div class="eyebrow dark" data-reveal><i></i> Atendimento, CRM e vendas no mesmo fluxo</div>
        <h1 data-reveal>Tenha inteligência artificial trabalhando <span>diretamente no seu WhatsApp.</span></h1>
        <p data-reveal>
          Ela conversa com seus clientes, entende o que cada pessoa precisa, qualifica cada oportunidade
          e atualiza o Kanban e o CRM automaticamente.
        </p>
        <div class="hero-actions" data-reveal>
          <a class="button button-primary" href="#produto">Ver como funciona <span aria-hidden="true">↓</span></a>
          <a class="button button-ghost" href={whatsappUrl} target="_blank" rel="noreferrer">Falar sobre minha operação <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="shell hero-product" data-reveal data-parallax="0.025">
        <HeroDemo />
      </div>

      <div id="fluxo-operacao" class="flow-strip" aria-label="Fluxo da operação">
        <div class="shell flow-intro">
          <p class="eyebrow dark">UMA OPERAÇÃO CONECTADA</p>
          <h2>Da primeira mensagem ao próximo passo.</h2>
          <p>Cada etapa acontece no momento certo, sem depender de planilhas ou memória.</p>
        </div>
        <div class="shell flow-items" data-scroll-focus-group>
          <div><i>01</i><span><strong>Cliente chama</strong><small>Uma conversa entra pelo WhatsApp</small></span></div>
          <div><i>02</i><span><strong>IA qualifica</strong><small>Entende perfil, interesse e potencial</small></span></div>
          <div><i>03</i><span><strong>CRM registra</strong><small>Dados e etapa são atualizados</small></span></div>
          <div><i>04</i><span><strong>Vendedor recebe</strong><small>Oportunidade pronta e com histórico</small></span></div>
          <div><i>05</i><span><strong>Sistema acompanha</strong><small>O retorno acontece no horário certo</small></span></div>
        </div>
      </div>
    </section>

    <section id="conversa-natural" class="human-section">
      <div class="shell human-grid">
        <div class="human-copy">
          <p class="eyebrow" data-reveal>CONVERSA NATURAL, OPERAÇÃO INTELIGENTE</p>
          <h2 data-reveal>A IA conversa sem parecer uma resposta automática.</h2>
          <p data-reveal>Ela entende áudio, reage às mensagens, mostra que está digitando e responde em partes, com o tom definido pela sua empresa.</p>
          <div class="human-features" data-reveal>
            <span><i>❤</i><b>Reage e acolhe</b><small>A conversa continua leve e natural.</small></span>
            <span><i>◖</i><b>Escuta antes de responder</b><small>Aguarda o cliente terminar e une o contexto.</small></span>
            <span><i>✦</i><b>Qualifica enquanto conversa</b><small>Transforma o diálogo em uma oportunidade organizada.</small></span>
          </div>
        </div>
        <div data-reveal><HumanizedAIDemo /></div>
      </div>
    </section>

    <section id="daniel" class="daniel-section">
      <div class="shell daniel-grid">
        <div class="daniel-photo" data-reveal>
          <div class="photo-light" aria-hidden="true"></div>
          <img
            src="/images/daniel-secondary.webp"
            alt="Daniel Junior, gestor de automação com inteligência artificial"
            width="1120"
            height="1400"
            loading="lazy"
            decoding="async"
          />
          <div class="photo-status"><i></i><span><small>ACOMPANHAMENTO</small><strong>Operação gerenciada</strong></span></div>
        </div>

        <div class="daniel-copy">
          <p class="eyebrow" data-reveal>QUEM IMPLEMENTA</p>
          <h2 data-reveal>Eu sou Daniel Junior. Gestor de automação com IA.</h2>
          <p data-reveal>
            Eu desenho e gerencio operações de atendimento que conectam WhatsApp, inteligência artificial,
            CRM e equipe comercial. Meu trabalho começa entendendo como a sua empresa realmente vende.
          </p>
          <p data-reveal>
            Depois, organizo o processo, implanto a tecnologia e acompanho o uso no dia a dia.
            Você fala comigo diretamente, desde a primeira conversa até os ajustes da operação.
          </p>
          <div class="daniel-points" data-reveal>
            <span><i>01</i><b>Implantação completa</b><small>Estrutura conectada à rotina da empresa.</small></span>
            <span><i>02</i><b>Ajustes no atendimento</b><small>Fluxos revistos conforme a equipe usa.</small></span>
            <span><i>03</i><b>Suporte e evolução</b><small>Acompanhamento para a operação continuar melhorando.</small></span>
          </div>
          <a class="text-link" href={whatsappUrl} target="_blank" rel="noreferrer" data-reveal>Conversar com Daniel <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section id="canais" class="omnichannel-section">
      <div class="shell omnichannel-grid">
        <div class="omnichannel-copy">
          <p class="eyebrow" data-reveal>TODOS OS CANAIS, UMA OPERAÇÃO</p>
          <h2 data-reveal>Uma única caixa de entrada para todas as conversas.</h2>
          <p data-reveal>WhatsApp, Instagram, TikTok e site chegam ao mesmo lugar. A equipe responde sem trocar de tela e a IA qualifica cada contato antes de encaminhar.</p>
          <div class="omnichannel-benefits" data-reveal>
            <span><i>01</i><b>Nenhuma mensagem dispersa</b></span>
            <span><i>02</i><b>Um histórico por cliente</b></span>
            <span><i>03</i><b>Qualificação em todos os canais</b></span>
          </div>
        </div>

        <div class="omnichannel-visual" data-reveal aria-label="WhatsApp, Instagram, TikTok e site conectados a uma única central de atendimento">
          <div class="channel-list">
            <article class="channel whatsapp"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></i><span><strong>WhatsApp</strong><small>12 novas</small></span></article>
            <article class="channel instagram"><i><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2"/></svg></i><span><strong>Instagram</strong><small>7 novas</small></span></article>
            <article class="channel tiktok"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg></i><span><strong>TikTok</strong><small>4 novas</small></span></article>
            <article class="channel website"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 100 20 10 10 0 000-20Zm6.9 6h-3.05a15.7 15.7 0 00-1.38-3.38A8.05 8.05 0 0118.9 8ZM12 4c.83 1.01 1.47 2.36 1.8 4h-3.6c.33-1.64.97-2.99 1.8-4ZM4.26 14a8.13 8.13 0 010-4h3.45a17.2 17.2 0 000 4H4.26Zm.84 2h3.05a15.7 15.7 0 001.38 3.38A8.05 8.05 0 015.1 16Zm3.05-8H5.1a8.05 8.05 0 014.43-3.38A15.7 15.7 0 008.15 8ZM12 20c-.83-1.01-1.47-2.36-1.8-4h3.6c-.33 1.64-.97 2.99-1.8 4Zm2.15-6h-4.3a15.2 15.2 0 010-4h4.3a15.2 15.2 0 010 4Zm.32 5.38A15.7 15.7 0 0015.85 16h3.05a8.05 8.05 0 01-4.43 3.38ZM16.29 14a17.2 17.2 0 000-4h3.45a8.13 8.13 0 010 4h-3.45Z"/></svg></i><span><strong>Chat do seu site</strong><small>3 novas</small></span></article>
          </div>
          <div class="channel-arrow" aria-hidden="true"><span>tudo chega aqui</span><i>→</i></div>
          <div class="inbox-hub">
            <header><span><i></i> CENTRAL UNIFICADA</span><b>26 conversas</b></header>
            <div class="inbox-title"><strong>Uma equipe responde tudo.</strong><small>A IA lê, entende e organiza antes.</small></div>
            <article><img src="/images/people/mariana.jpg" alt="" width="64" height="64"/><span><strong>Mariana Costa</strong><small>Instagram · Atacado</small></span><b>Qualificada</b></article>
            <article><img src="/images/people/fernanda.jpg" alt="" width="64" height="64"/><span><strong>Fernanda Lima</strong><small>WhatsApp · Orçamento</small></span><b>Em conversa</b></article>
            <footer><i>✦</i><span><small>IA TRABALHANDO</small><strong>2 contatos qualificados agora</strong></span></footer>
          </div>
        </div>
      </div>
    </section>

    <section id="produto" class="product-section">
      <div class="product-mesh" aria-hidden="true"></div>
      <div class="shell">
        <div class="section-heading dark-heading">
          <div>
            <p class="eyebrow dark" data-reveal>VEJA O PRODUTO FUNCIONANDO</p>
            <h2 data-reveal>Veja a operação por dentro.</h2>
          </div>
          <p data-reveal>Alterne entre a caixa de entrada, o pipeline comercial e as automações que trabalham nos bastidores.</p>
        </div>
        <div data-reveal>
          <ProductShowcase />
        </div>
      </div>
    </section>

    <section id="configuracao" class="qualification-config-section">
      <div class="shell">
        <div class="qualification-config-heading">
          <div><p class="eyebrow" data-reveal>QUALIFICAÇÃO CONFIGURÁVEL</p><h2 data-reveal>Você define como a conversa começa e qual será o próximo passo.</h2></div>
          <p data-reveal>A IA aplica o mesmo raciocínio em qualquer porta de entrada e encerra cada qualificação da forma que fizer sentido para sua operação.</p>
        </div>
        <div class="qualification-map" data-reveal>
          <section class="trigger-options"><header><i>01</i><span><small>ONDE COMEÇA</small><strong>Você escolhe quando a IA entra</strong></span></header><div><span><b>▣</b><em><strong>Simulação no site</strong><small>O visitante inicia um atendimento pelo site.</small></em></span><span><b>≡</b><em><strong>Formulário enviado</strong><small>A IA chama assim que o formulário chega.</small></em></span><span><b>◉</b><em><strong>Nova mensagem no WhatsApp</strong><small>A qualificação começa na primeira mensagem.</small></em></span></div></section>
          <div class="map-arrow"><span>entra</span><i>→</i></div>
          <section class="qualification-engine"><span>✦</span><small>INTELIGÊNCIA ARTIFICIAL</small><strong>Qualificação acontecendo</strong><p>Regras, tom e perguntas definidos para sua empresa.</p><div class="engine-workflow"><span><i>01</i><b>Lendo o contexto</b></span><span><i>02</i><b>Identificando o interesse</b></span><span><i>03</i><b>Qualificando o lead</b></span></div></section>
          <div class="map-arrow"><span>finaliza</span><i>→</i></div>
          <section class="finish-options"><header><i>03</i><span><small>COMO TERMINA</small><strong>Você define o próximo passo</strong></span></header><div><span><b>▦</b><em><strong>Agendamento</strong><small>Data e horário confirmados.</small></em></span><span><b>☎</b><em><strong>Ligação</strong><small>O vendedor recebe o lead para ligar.</small></em></span><span><b>◫</b><em><strong>Call</strong><small>Reunião encaminhada para a equipe.</small></em></span><span><b>✉</b><em><strong>Mensagem direta</strong><small>Conversa e histórico chegam ao responsável.</small></em></span></div></section>
        </div>
      </div>
    </section>

    <section id="distribuicao" class="routing-section">
      <div class="shell routing-grid">
        <div class="routing-copy">
          <p class="eyebrow" data-reveal>RODÍZIO DA EQUIPE</p>
          <h2 data-reveal>O cliente certo chega à pessoa certa.</h2>
          <p data-reveal>
            Regras de região, produto e carteira definem quem continua o atendimento.
            A distribuição deixa de ser uma decisão manual.
          </p>
          <ul data-reveal>
            <li><i>01</i><span><strong>Setor ou responsável direto</strong><small>Financeiro, suporte ou comercial recebem o assunto certo.</small></span></li>
            <li><i>02</i><span><strong>Vendedores por rodízio</strong><small>A fila distribui em ordem e mantém a equipe equilibrada.</small></span></li>
            <li><i>03</i><span><strong>Preferência do próprio lead</strong><small>Se ele pedir alguém, a solicitação é respeitada.</small></span></li>
          </ul>
        </div>

        <div class="routing-demo" data-reveal aria-label="Exemplo de distribuição automática">
          <div class="routing-top"><span>Nova conversa qualificada</span><b>Distribuindo...</b></div>
          <div class="routing-source"><img src="/images/people/mariana.jpg" alt="" width="72" height="72" /><div><small>LEAD QUALIFICADO</small><strong>Mariana Costa</strong><span>Atacado · 150 peças · Alta intenção</span><em><i>✓</i> Qualificação concluída</em></div><b>Pronta</b></div>
          <div class="routing-line"><span></span><i>↓</i><span></span></div>
          <div class="routing-decision"><i></i> A IA compara especialidade e posição na fila</div>
          <div class="seller-grid">
            <article class="candidate-one"><img src="/images/people/amanda.jpg" alt="" width="72" height="72" /><strong>Camila</strong><small>Varejo</small></article>
            <article class="selected candidate-two"><span>Melhor opção</span><img src="/images/people/rafael.jpg" alt="" width="72" height="72" /><strong>Rafael</strong><small>Atacado</small></article>
            <article class="candidate-three"><img src="/images/people/lucas.jpg" alt="" width="72" height="72" /><strong>Lucas</strong><small>São Paulo</small></article>
          </div>
          <div class="routing-result"><i>✓</i><span><small>CONVERSA ENCAMINHADA</small><strong>Rafael recebeu todo o histórico</strong></span><time>agora</time></div>
          <div class="lead-memory">
            <header><i>✦</i><span><small>MEMÓRIA DO LEAD</small><strong>A conversa continua sem começar do zero.</strong></span></header>
            <div class="memory-thread">
              <article><small>ÚLTIMO ATENDIMENTO</small><p>Mariana procura 150 peças para entrega na Região Sul.</p></article>
              <span aria-hidden="true">↓</span>
              <article class="memory-resume"><small>A IA RETOMA COM O CONTEXTO</small><p>Mariana, já encontrei o vendedor de atacado para continuar seu atendimento.</p></article>
            </div>
            <footer><i>✓</i> Interesse, volume e preferências continuam registrados.</footer>
          </div>
        </div>
      </div>
    </section>

    <section id="follow-up" class="followup-section">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow" data-reveal>FOLLOW-UP AUTOMÁTICO</p>
            <h2 data-reveal>Recupere clientes que pararam de responder.</h2>
          </div>
          <p data-reveal>A IA chama o cliente novamente no momento certo, com a mensagem e o contexto já preparados.</p>
        </div>
        <div class="followup-wrapper" data-reveal>
          <FollowUpDemo />
        </div>
      </div>
    </section>

    <section id="controle" class="control-section">
      <div class="control-grid-bg" aria-hidden="true"></div>
      <div class="shell control-grid">
        <div class="control-copy">
          <p class="eyebrow dark" data-reveal>TUDO FICA REGISTRADO</p>
          <h2 data-reveal>Cada decisão deixa um registro.</h2>
          <p data-reveal>Veja quando algo mudou, por que mudou e quem assumiu o próximo passo. Gestão sem depender de relatos.</p>
          <div class="governance-list" data-reveal>
            <div><i>01</i><span><strong>Veja o que cada pessoa fez</strong><small>Atendente, vendedor, etapa, horário e decisão ficam registrados.</small></span></div>
            <div><i>02</i><span><strong>Proteção contra exclusões</strong><small>Conversa, mensagem e contato só podem ser apagados com autorização do administrador.</small></span></div>
            <div><i>03</i><span><strong>Memória preservada</strong><small>A IA retoma o raciocínio sabendo o que aconteceu no último atendimento.</small></span></div>
          </div>
        </div>

        <div class="history-panel" data-reveal aria-label="Histórico de uma conversa">
          <header><div><img src="/images/people/mariana.jpg" alt="" width="64" height="64" /><span><strong>Mariana Costa</strong><small>O que aconteceu desde a primeira mensagem</small></span></div><b>Qualificado</b></header>
          <ol data-scroll-focus-group>
            <li><i class="message-icon">01</i><div><small>ETAPA 1 · RESPOSTA</small><strong>A dúvida foi respondida na hora.</strong><p>A IA respondeu e manteve o cliente na conversa.</p></div><time>10:24</time></li>
            <li><i class="data-icon">02</i><div><small>ETAPA 2 · ORGANIZAÇÃO</small><strong>Os dados entraram no CRM.</strong><p>Interesse, volume e região foram registrados.</p></div><time>10:25</time></li>
            <li><i class="move-icon">03</i><div><small>ETAPA 3 · QUALIFICAÇÃO</small><strong>A oportunidade virou “Qualificado”.</strong><p>A IA atualizou a etapa comercial no Kanban.</p></div><time>10:25</time></li>
            <li><i class="person-icon">04</i><div><small>ETAPA 4 · DISTRIBUIÇÃO</small><strong>Rafael recebeu a conversa.</strong><p>O rodízio escolheu o vendedor e enviou o contexto.</p></div><time>10:25</time></li>
            <li><i class="clock-icon">05</i><div><small>ETAPA 5 · PRÓXIMO PASSO</small><strong>O retorno ficou agendado.</strong><p>A próxima ação ficou pronta para acontecer.</p></div><time>10:26</time></li>
          </ol>
        </div>
      </div>
    </section>

    <section id="implantacao" class="process-section">
      <div class="shell">
        <div class="process-intro">
          <p class="eyebrow" data-reveal>COMO A IMPLANTAÇÃO FUNCIONA</p>
          <h2 data-reveal>Implantação em quatro etapas.</h2>
