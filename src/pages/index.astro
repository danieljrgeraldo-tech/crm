---
import SiteLayout from "../layouts/SiteLayout.astro";
import CrmHeader from "../components/crm/CrmHeader.astro";
import Section01Hero from "../components/crm/Section01Hero.astro";
import Section02SimulatorPdf from "../components/crm/Section02SimulatorPdf.astro";
import Section03Memory from "../components/crm/Section03Memory.astro";
import Section04CrmKanban from "../components/crm/Section04CrmKanban.astro";
import SectionCrmOverview from "../components/crm/SectionCrmOverview.astro";
import Section05Followup from "../components/crm/Section05Followup.astro";
import Section06Scheduling from "../components/crm/Section06Scheduling.astro";
import Section07QualificationSummary from "../components/crm/Section07QualificationSummary.astro";
import Section08TeamDistribution from "../components/crm/Section08TeamDistribution.astro";
import Section09ManagerControl from "../components/crm/Section09ManagerControl.astro";
import Section10Segments from "../components/crm/Section10Segments.astro";
import Section11DanielImplementation from "../components/crm/Section11DanielImplementation.astro";
import Section12CtaFinal from "../components/crm/Section12CtaFinal.astro";
import CrmFooter from "../components/crm/CrmFooter.astro";
---

<SiteLayout
  title="Daniel Junior | IA no seu WhatsApp para Atendimento, CRM e Vendas"
  description="Uma IA no seu WhatsApp que atende, agenda, vende e não deixa cliente sem resposta. Conheça a operação comercial automática."
  robots="index, follow"
  canonicalUrl="https://ia.danieljunior.com.br/"
>
  <CrmHeader />

  <main>
    <!-- 01. Hero (Dark Slate) -->
    <Section01Hero />

    <!-- 02. Carro-Chefe (LIGHT SECTION - Form -> PDF A4 -> WhatsApp -> IA) -->
    <Section02SimulatorPdf />

    <!-- 03. Memória Continuada (Dark Slate) -->
    <Section03Memory />

    <!-- 04. Organização / CRM / Kanban (Showcase Real Chatwoot) -->
    <Section04CrmKanban />

    <!-- 05. BLOCO EXCLUSIVO CRM: Além da IA, o que mais você faz no seu CRM? (LIGHT SECTION) -->
    <SectionCrmOverview />

    <!-- 06. Follow-up Contextual (Dark Slate) -->
    <Section05Followup />

    <!-- 07. Agendamento & Lembretes (LIGHT SECTION) -->
    <Section06Scheduling />

    <!-- 08. Pré-venda & Qualificação (Ficha dentro do Card de Kanban) -->
    <Section07QualificationSummary />

    <!-- 09. Distribuição para Equipe (Dark Slate) -->
    <Section08TeamDistribution />

    <!-- 10. Visão Geral do Gestor (Dark Slate) -->
    <Section09ManagerControl />

    <!-- 11. Aplicações por Segmento (LIGHT SECTION) -->
    <Section10Segments />

    <!-- 12. Implementação Customizada / Daniel Junior (Consultoria para Ideias Exclusivas) -->
    <Section11DanielImplementation />

    <!-- 13. CTA Final -->
    <Section12CtaFinal />
  </main>

  <CrmFooter />
</SiteLayout>

<style>
  main {
    overflow: hidden;
    background: #0f172a;
  }
</style>
