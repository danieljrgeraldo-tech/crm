---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import SectionTitle from "../components/SectionTitle.astro";
import SolutionCard from "../components/SolutionCard.astro";
import BenefitCard from "../components/BenefitCard.astro";
import ListPanel from "../components/ListPanel.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import {
  homeEquityApplications,
  homeEquityBenefits,
  investorPossibilities,
  patrimonyPossibilities,
  reasons,
  retailBenefits,
  solutions,
  whatsappUrl
} from "../data/site";
---

<BaseLayout>
  <Header />
  <main>
    <Hero />

    <section class="section-dark px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-6xl">
        <SectionTitle title="Quem sou eu?" align="center" />
        <div class="mx-auto mt-10 grid max-w-5xl gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
          <div class="section-reveal space-y-5 text-center text-base leading-8 text-white/70 sm:text-lg lg:text-left">
            <p>
              Atuo com negócios e desenvolvimento empresarial desde 2013. Ao longo dessa trajetória, construí relacionamento com empresários, investidores, fundos privados e parceiros estratégicos, participando de operações voltadas a crédito, capital, investimentos e crescimento empresarial.
            </p>
            <p>
              Hoje atuo conectando empresas e investidores às oportunidades e soluções mais adequadas para cada cenário.
            </p>
          </div>
          <ListPanel title="Meu papel" items={["Entender cenários", "Identificar oportunidades", "Conectar pessoas às soluções certas"]} mobileCenter />
        </div>
      </div>
    </section>

    <section id="solucoes" class="section-light px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-7xl">
        <SectionTitle
          title="Como posso ajudar?"
          subtitle="Nem toda empresa precisa da mesma solução."
          text="Antes de falar sobre produtos, procuro entender o momento da empresa para identificar o melhor caminho para crescer, investir ou acessar capital."
          align="center"
          tone="light"
        />
        <p class="section-reveal mx-auto mt-7 max-w-3xl text-center text-lg leading-8 text-stone-700">
          O objetivo não é oferecer produtos. É encontrar a solução mais adequada para cada necessidade.
        </p>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {solutions.map((solution, index) => <SolutionCard title={solution} index={index + 1} tone="light" />)}
        </div>
      </div>
    </section>

    <section id="capital" class="section-dark px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1fr_.9fr] lg:items-center">
        <div>
          <SectionTitle title="Soluções em Capital" subtitle="Soluções em Crédito e Home Equity" />
          <p class="section-reveal mt-6 text-base leading-8 text-white/70 sm:text-lg">
            Oferecemos soluções de Home Equity para proprietários de imóveis que desejam transformar patrimônio em capital para investir, expandir seus negócios ou aproveitar novas oportunidades.
          </p>
          <p class="section-reveal mt-8 border-l border-gold-300/40 pl-5 font-display text-3xl font-semibold leading-tight text-gold-100 sm:text-4xl">
            Capital para quem quer crescer sem vender patrimônio.
          </p>
        </div>
        <ListPanel title="Aplicações" items={homeEquityApplications} />
      </div>
    </section>

    <section class="section-warm px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-7xl">
        <SectionTitle title="Benefícios exclusivos do Home Equity" align="center" tone="light" />
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {homeEquityBenefits.map((benefit) => <BenefitCard title={benefit.title} text={benefit.text} tone="light" />)}
        </div>
      </div>
    </section>

    <section class="section-dark px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.95fr_1.05fr] lg:items-center">
        <div>
          <SectionTitle title="Crédito e Patrimônio" subtitle="Aquisição Patrimonial e Crédito" />
          <p class="section-reveal mt-6 text-base leading-8 text-white/70 sm:text-lg">
            Soluções voltadas para quem deseja adquirir patrimônio, expandir seus negócios ou acessar crédito através de cartas contempladas e consórcios selecionados.
          </p>
          <p class="section-reveal mt-8 border-l border-gold-300/40 pl-5 font-display text-3xl font-semibold leading-tight text-gold-100 sm:text-4xl">
            Uma alternativa estratégica para quem busca patrimônio, crédito e crescimento.
          </p>
        </div>
        <ListPanel items={patrimonyPossibilities} />
      </div>
    </section>

    <section class="section-light px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.95fr_1.05fr] lg:items-center">
        <div>
          <SectionTitle
            title="Soluções para Lojistas"
            subtitle="Venda mais com PIX Parcelado Garantido"
            text="Permita que seus clientes parcelem no PIX e aumente suas oportunidades de venda. Através de uma estrutura de garantia, assumimos a operação e protegemos o estabelecimento contra inadimplência, permitindo mais vendas e menos riscos."
            tone="light"
          />
        </div>
        <ListPanel title="Benefícios" items={retailBenefits} tone="light" />
      </div>
    </section>

    <section id="investidores" class="section-dark px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
        <div>
          <SectionTitle
            title="Investidores"
            subtitle="Oportunidades para Investidores"
            text="Identificamos oportunidades para investidores que desejam fazer seu capital trabalhar através de operações privadas, com alternativas que vão desde opções conservadoras até oportunidades de maior retorno."
          />
          <p class="section-reveal mt-8 border-l border-gold-300/40 pl-5 font-display text-3xl font-semibold leading-tight text-gold-100 sm:text-4xl">
            Seu capital trabalhando de forma estratégica para gerar renda e novas oportunidades.
          </p>
        </div>
        <ListPanel items={investorPossibilities} />
      </div>
    </section>

    <section class="section-warm px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-7xl">
        <SectionTitle
          title="Por que trabalhar comigo?"
          text="Antes de falar sobre soluções, procuro entender cada cenário para identificar as oportunidades mais adequadas para seus objetivos."
          align="center"
          tone="light"
        />
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {reasons.map((reason) => (
            <article class="section-reveal rounded-lg border border-stone-200 bg-white p-5 text-center shadow-card">
              <span class="checkmark mx-auto mb-5" aria-hidden="true"></span>
              <h3 class="text-base font-semibold leading-snug text-stone-950">{reason}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
  <a href={whatsappUrl} target="_blank" rel="noreferrer" class="mobile-whatsapp">WhatsApp</a>
  <script is:inline>
    const revealItems = document.querySelectorAll(".section-reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.16, rootMargin: "0px 0px -40px 0px" }
    );

    revealItems.forEach((item, index) => {
      item.style.transitionDelay = `${Math.min(index % 5, 4) * 70}ms`;
      observer.observe(item);
    });

    const mobileWhatsapp = document.querySelector(".mobile-whatsapp");
    const heroPortrait = document.querySelector(".hero-portrait");
    let ticking = false;

    const updateHeroParallax = () => {
      const offset = Math.min(window.scrollY * 0.025, 16);
      if (heroPortrait) {
        heroPortrait.style.setProperty("--hero-parallax", `${offset}px`);
      }
      ticking = false;
    };

    const toggleMobileWhatsapp = () => {
      mobileWhatsapp?.classList.toggle("is-visible", window.scrollY > 720);
      if (!ticking) {
        window.requestAnimationFrame(updateHeroParallax);
        ticking = true;
      }
    };

    toggleMobileWhatsapp();
    window.addEventListener("scroll", toggleMobileWhatsapp, { passive: true });
  </script>
</BaseLayout>
