---
import SiteLayout from "../layouts/SiteLayout.astro";

const whatsappUrl =
  "https://wa.me/5548998493150?text=" +
  encodeURIComponent(
    "Olá, Daniel. Quero entender como organizar o atendimento e o acompanhamento comercial da minha empresa."
  );

const painPoints = [
  {
    number: "01",
    title: "Conversas espalhadas",
    text: "O cliente chama, troca de atendente e o contexto se perde entre celulares, anotações e planilhas.",
  },
  {
    number: "02",
    title: "Vendas sem acompanhamento",
    text: "Orçamentos são enviados, mas ninguém sabe com clareza quem respondeu, quem esfriou ou quem precisa de retorno.",
  },
  {
    number: "03",
    title: "Gestão no escuro",
    text: "Sem uma visão única da operação, decisões importantes dependem de percepção — não de informação organizada.",
  },
];

const managementPillars = [
  {
    number: "01",
    title: "Entender",
    text: "Mapeio como os clientes chegam, quem atende e onde as oportunidades se perdem.",
  },
  {
    number: "02",
    title: "Organizar",
    text: "Estruturo etapas, responsáveis, históricos e regras claras para o atendimento.",
  },
  {
    number: "03",
    title: "Automatizar",
    text: "A tecnologia assume tarefas repetitivas sem tirar o controle da equipe.",
  },
  {
    number: "04",
    title: "Acompanhar",
    text: "Reviso o funcionamento, ajusto os fluxos e mantenho a operação evoluindo.",
  },
];

const followupSteps = [
  ["Agora", "Novo contato recebido", "Atendimento iniciado e oportunidade registrada."],
  ["+ 1 dia", "Retorno programado", "A equipe sabe exatamente quem precisa ser procurado."],
  ["+ 3 dias", "Oportunidade acompanhada", "O histórico continua completo, mesmo se o responsável mudar."],
  ["No fechamento", "Resultado registrado", "A gestão enxerga o que avançou, o que parou e por quê."],
];

const faqItems = [
  [
    "Isso é um software que eu compro?",
    "Não. Daniel atua como gestor da operação. As ferramentas são escolhidas e configuradas de acordo com a realidade da empresa.",
  ],
  [
    "Minha equipe precisa mudar a forma de atender?",
    "O processo é desenhado para facilitar a rotina. A implantação considera o que já funciona e organiza o que hoje depende de improviso.",
  ],
  [
    "A automação substitui vendedores?",
    "Não. Ela cuida de tarefas repetitivas, organiza informações e ajuda a equipe a agir no momento certo.",
  ],
  [
    "Depois da implantação eu fico sozinho?",
    "Não. O acompanhamento contínuo é parte do trabalho: a operação é observada, ajustada e melhorada ao longo do tempo.",
  ],
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Daniel Junior — Gestão de Automação com IA",
  url: "https://danieljunior.com.br",
  description:
    "Gestão de automação com IA para empresas que vendem e atendem pelo WhatsApp.",
  areaServed: "BR",
  serviceType: "Gestão de automação, atendimento e operação comercial",
};
---

<SiteLayout
  title="Daniel Junior | Gestão de Automação com IA"
  description="Organize atendimento, equipe e oportunidades com uma operação acompanhada de perto por Daniel Junior, Gestor de Automação com IA."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

  <header class="site-header" data-header>
    <div class="shell header-inner">
      <a class="brand" href="#inicio" aria-label="Daniel Junior — início">
        <strong>Daniel Junior</strong>
        <span>Gestão de Automação com IA</span>
      </a>

      <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-nav">
        <span class="sr-only">Abrir menu</span>
        <i></i><i></i>
      </button>

      <nav id="main-nav" class="main-nav" aria-label="Navegação principal">
        <a href="#desafio">O desafio</a>
        <a href="#operacao">A operação</a>
        <a href="#metodo">Como funciona</a>
        <a href="#sobre">Sobre</a>
      </nav>

      <a class="header-action" href={whatsappUrl} target="_blank" rel="noreferrer">
        Conversar com Daniel <span aria-hidden="true">↗</span>
      </a>
    </div>
  </header>

  <main id="conteudo">
    <section id="inicio" class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow" data-reveal>Gestão de atendimento & automação</p>
          <h1 data-reveal>
            Seu atendimento pode funcionar com mais
            <em>clareza, ritmo e controle.</em>
          </h1>
          <p class="hero-lead" data-reveal>
            Eu organizo pessoas, processos e tecnologia para sua empresa atender melhor,
            acompanhar oportunidades e parar de perder vendas por falta de processo.
          </p>
          <div class="hero-actions" data-reveal>
            <a class="button button-dark" href={whatsappUrl} target="_blank" rel="noreferrer">
              Quero organizar minha operação <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#operacao">Ver como funciona <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-proof" data-reveal>
            <span>Estratégia</span><i></i><span>Implantação</span><i></i><span>Acompanhamento</span>
          </div>
        </div>

        <div class="hero-visual" data-reveal>
          <div class="portrait-frame">
            <img
              src="/images/daniel-hero.webp"
              alt="Daniel Junior, Gestor de Automação com IA"
              width="1800"
              height="2400"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <div class="status-card status-card-top" aria-hidden="true">
            <span class="status-dot"></span>
            <div>
              <small>Operação acompanhada</small>
              <strong>Atendimento em ordem</strong>
            </div>
          </div>

          <div class="status-card status-card-bottom" aria-hidden="true">
            <span class="mini-label">Hoje</span>
            <strong>12 oportunidades</strong>
            <small>com próximo passo definido</small>
          </div>
        </div>
      </div>
      <div class="shell hero-foot">
        <p>Para empresas que vendem pelo WhatsApp e precisam transformar conversa em processo.</p>
      </div>
    </section>

    <section id="desafio" class="section section-paper">
      <div class="shell">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow" data-reveal>O problema não é falta de esforço</p>
            <h2 data-reveal>Quando o atendimento cresce sem estrutura, a operação perde o controle.</h2>
          </div>
          <p data-reveal>
            Mais mensagens não significam mais vendas. Sem organização, a equipe trabalha muito,
            clientes esperam e oportunidades desaparecem na rotina.
          </p>
        </div>

        <div class="pain-grid">
          {painPoints.map((item) => (
            <article class="pain-card" data-reveal>
              <span>{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>

        <div class="statement" data-reveal>
          <span>Não é sobre colocar mais uma ferramenta na empresa.</span>
          <strong>É sobre construir uma operação que as pessoas conseguem seguir.</strong>
        </div>
      </div>
    </section>

    <section id="operacao" class="section operation-section">
      <div class="shell">
        <div class="section-heading centered">
          <p class="eyebrow" data-reveal>Uma central para a operação</p>
          <h2 data-reveal>Conversas, equipe e oportunidades no mesmo lugar.</h2>
          <p data-reveal>
            Cada cliente ganha histórico, responsável, etapa e próximo passo.
            A tecnologia trabalha nos bastidores; sua equipe enxerga apenas o que precisa fazer.
          </p>
        </div>

        <div class="crm-window" data-reveal>
          <div class="window-bar" aria-hidden="true">
            <div class="window-dots"><i></i><i></i><i></i></div>
            <span>Central de Atendimento</span>
            <div class="live-pill"><i></i> Operação ativa</div>
          </div>
          <div class="crm-image-wrap">
            <img
              src="/images/crm/painel-atendimento.webp"
              alt="Central de atendimento em português com lista de conversas, histórico e perfil do cliente"
              width="1800"
              height="1187"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="feature-row">
          <article data-reveal>
            <span class="feature-index">01</span>
            <h3>Histórico completo</h3>
            <p>Quem assumir a conversa entende o contexto sem pedir que o cliente conte tudo de novo.</p>
          </article>
          <article data-reveal>
            <span class="feature-index">02</span>
            <h3>Responsabilidade clara</h3>
            <p>Cada oportunidade tem um responsável e nenhuma conversa fica sem dono.</p>
          </article>
          <article data-reveal>
            <span class="feature-index">03</span>
            <h3>Prioridades visíveis</h3>
            <p>Etiquetas, etapas e alertas mostram o que exige atenção antes que seja tarde.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section pipeline-section">
      <div class="shell pipeline-layout">
        <div class="pipeline-copy">
          <p class="eyebrow" data-reveal>Visão comercial</p>
          <h2 data-reveal>Todo contato tem um caminho — e a gestão consegue enxergar.</h2>
          <p data-reveal>
            O quadro transforma conversas em uma rotina comercial visual. A equipe sabe o que avançou,
            o que precisa de retorno e onde a operação está travando.
          </p>
          <ul data-reveal>
            <li><i></i> Etapas adaptadas ao seu processo</li>
            <li><i></i> Movimentação simples entre responsáveis</li>
            <li><i></i> Resultado registrado sem planilha paralela</li>
          </ul>
        </div>

        <div class="kanban" data-reveal aria-label="Exemplo de quadro de oportunidades">
          <div class="kanban-head">
            <div>
              <small>Pipeline comercial</small>
              <strong>Oportunidades</strong>
            </div>
            <span>Esta semana</span>
          </div>
          <div class="kanban-columns">
            <div class="kanban-column">
              <div class="column-title"><span>Novo contato</span><b>3</b></div>
              <div class="lead-card">
                <small>Distribuidora Aurora</small>
                <strong>Catálogo solicitado</strong>
                <div><i class="avatar a1">LM</i><span>há 12 min</span></div>
              </div>
              <div class="lead-card muted-card">
                <small>Studio Nativa</small>
                <strong>Primeiro atendimento</strong>
                <div><i class="avatar a2">RS</i><span>há 28 min</span></div>
              </div>
            </div>
            <div class="kanban-column">
              <div class="column-title"><span>Em negociação</span><b>4</b></div>
              <div class="lead-card featured-card">
                <span class="card-tag">Prioridade</span>
                <small>Casa Horizonte</small>
                <strong>Proposta enviada</strong>
                <div><i class="avatar a3">AD</i><span>Retorno hoje</span></div>
              </div>
              <div class="lead-card">
                <small>Grupo Essenza</small>
                <strong>Condições alinhadas</strong>
                <div><i class="avatar a4">VT</i><span>amanhã</span></div>
              </div>
            </div>
            <div class="kanban-column">
              <div class="column-title"><span>Fechamento</span><b>2</b></div>
              <div class="lead-card success-card">
                <span class="card-tag">Próximo passo</span>
                <small>Mercado da Vila</small>
                <strong>Confirmação do pedido</strong>
                <div><i class="avatar a5">TS</i><span>às 16h</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section followup-section">
      <div class="shell">
        <div class="section-heading split-heading light-heading">
          <div>
            <p class="eyebrow" data-reveal>Follow-up que acontece</p>
            <h2 data-reveal>O cliente não some. O processo é que deixa de acompanhar.</h2>
          </div>
          <p data-reveal>
            Com cadência e responsabilidade definidas, cada oportunidade recebe o próximo contato
            no momento certo — sem depender da memória de alguém.
          </p>
        </div>

        <div class="timeline" data-reveal>
          {followupSteps.map(([time, title, text], index) => (
            <article>
              <span class="timeline-number">{String(index + 1).padStart(2, "0")}</span>
              <small>{time}</small>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="metodo" class="section method-section">
      <div class="shell">
        <div class="section-heading centered">
          <p class="eyebrow" data-reveal>Gestão, não instalação</p>
          <h2 data-reveal>Da rotina atual a uma operação que continua melhorando.</h2>
          <p data-reveal>
            Daniel acompanha o processo de ponta a ponta. A ferramenta é apenas uma parte de uma
            gestão que combina diagnóstico, implantação e evolução.
          </p>
        </div>

        <div class="method-grid">
          {managementPillars.map((pillar) => (
            <article data-reveal>
              <span>{pillar.number}</span>
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
            </article>
          ))}
        </div>

        <div class="method-note" data-reveal>
          <span class="pulse" aria-hidden="true"></span>
          <p><strong>Acompanhamento contínuo:</strong> fluxos mudam, equipes crescem e a operação precisa evoluir junto.</p>
        </div>
      </div>
    </section>

    <section id="sobre" class="section about-section">
      <div class="shell about-grid">
        <div class="about-image" data-reveal>
          <img
            src="/images/daniel-secondary.webp"
            alt="Daniel Junior em ambiente de trabalho"
            width="1120"
            height="1500"
            loading="lazy"
            decoding="async"
          />
          <div class="about-badge">
            <span>Desde 2013</span>
            <small>atuando com negócios e operações</small>
          </div>
        </div>

        <div class="about-copy">
          <p class="eyebrow" data-reveal>Quem conduz a operação</p>
          <h2 data-reveal>Daniel Junior</h2>
          <p class="role" data-reveal>Gestor de Automação com IA</p>
          <p data-reveal>
            Minha função não é entregar um sistema e desaparecer. Eu entendo a rotina,
            desenho o processo, conecto as ferramentas e acompanho a operação para que
            atendimento e vendas funcionem com mais organização.
          </p>
          <p data-reveal>
            A tecnologia entra onde pode reduzir trabalho repetitivo, dar visibilidade à gestão
            e ajudar pessoas a tomarem decisões melhores.
          </p>
          <div class="quote" data-reveal>
            “Automação boa é a que sua equipe entende, sua gestão acompanha e seu cliente percebe como cuidado.”
          </div>
        </div>
      </div>
    </section>

    <section class="section faq-section">
      <div class="shell faq-grid">
        <div class="faq-intro">
          <p class="eyebrow" data-reveal>Antes de começar</p>
          <h2 data-reveal>Perguntas que ajudam a entender o trabalho.</h2>
        </div>
        <div class="faq-list" data-reveal>
          {faqItems.map(([question, answer], index) => (
            <details>
              <summary><span>{String(index + 1).padStart(2, "0")}</span>{question}<i>+</i></summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contato" class="final-cta">
      <div class="final-glow" aria-hidden="true"></div>
      <div class="shell final-content">
        <p class="eyebrow" data-reveal>O próximo passo é uma conversa</p>
        <h2 data-reveal>Sua operação pode ser mais organizada do que é hoje.</h2>
        <p data-reveal>
          Conte como sua equipe atende atualmente. Daniel analisa o cenário e mostra
          onde processos e automação podem gerar mais controle.
        </p>
        <a class="button button-light" href={whatsappUrl} target="_blank" rel="noreferrer" data-reveal>
          Conversar com Daniel no WhatsApp <span aria-hidden="true">↗</span>
        </a>
        <small data-reveal>Conversa direta, sem compromisso e sem apresentação genérica.</small>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <div class="brand footer-brand">
        <strong>Daniel Junior</strong>
        <span>Gestão de Automação com IA</span>
      </div>
      <p>Estratégia, implantação e acompanhamento para operações de atendimento.</p>
      <div>
        <a href="#inicio">Voltar ao topo ↑</a>
        <span>© 2026 Daniel Junior</span>
      </div>
    </div>
  </footer>

  <script>
    const header = document.querySelector("[data-header]");
    const menuButton = document.querySelector(".menu-button");
    const nav = document.querySelector(".main-nav");

    menuButton?.addEventListener("click", () => {
      const expanded = menuButton.getAttribute("aria-expanded") === "true";
      menuButton.setAttribute("aria-expanded", String(!expanded));
      nav?.classList.toggle("is-open", !expanded);
      document.body.classList.toggle("menu-open", !expanded);
    });

    nav?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menuButton?.setAttribute("aria-expanded", "false");
        nav.classList.remove("is-open");
        document.body.classList.remove("menu-open");
      });
    });

    const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 24);
    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });

    const revealItems = document.querySelectorAll("[data-reveal]");
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      document.documentElement.classList.add("has-motion");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px" }
      );
      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</SiteLayout>

<style>
  :global(:root) {
    --cream: #f4efe7;
    --cream-2: #ebe2d6;
    --white: #fffdf9;
    --charcoal: #171916;
    --charcoal-2: #242721;
    --forest: #20392e;
    --sage: #879c8d;
    --copper: #ad6a45;
    --copper-soft: #d3a17d;
    --line: rgba(23, 25, 22, 0.15);
    --muted: #68695f;
    --shell: min(1240px, calc(100vw - 48px));
  }

  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: var(--cream); color: var(--charcoal); overflow-x: hidden; }
  :global(body.menu-open) { overflow: hidden; }
  :global(.shell) { width: var(--shell); margin-inline: auto; }
  :global(.skip-link) {
    position: fixed; left: 1rem; top: 1rem; z-index: 100;
    transform: translateY(-150%); background: var(--white); color: var(--charcoal);
    padding: .75rem 1rem; border: 1px solid var(--charcoal);
  }
  :global(.skip-link:focus) { transform: translateY(0); }
  :global(.eyebrow) {
    display: flex; align-items: center; gap: .75rem; color: var(--copper);
    font-size: .72rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase;
  }
  :global(.eyebrow::before) { content: ""; width: 1.75rem; height: 1px; background: currentColor; }
  :global(.section) { padding: clamp(5rem, 9vw, 9rem) 0; }
  :global(.section-heading h2) {
    margin-top: 1.25rem; font-family: var(--font-display); font-weight: 300;
    font-size: clamp(2.7rem, 5.6vw, 5.4rem); line-height: .98; letter-spacing: -.045em;
  }
  :global(.section-heading > p:not(.eyebrow)) {
    color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.7;
  }

  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 50; border-bottom: 1px solid transparent;
    transition: background .3s ease, border-color .3s ease, backdrop-filter .3s ease;
  }
  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--cream) 88%, transparent);
    border-color: var(--line); backdrop-filter: blur(18px);
  }
  .header-inner { height: 86px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; }
  .brand { display: inline-flex; flex-direction: column; line-height: 1.1; width: max-content; }
  .brand strong { font-family: var(--font-display); font-size: 1.35rem; font-weight: 500; letter-spacing: -.02em; }
  .brand span { margin-top: .25rem; color: var(--muted); font-size: .58rem; letter-spacing: .13em; text-transform: uppercase; }
  .main-nav { display: flex; gap: 2rem; font-size: .82rem; color: #42453e; }
  .main-nav a { position: relative; padding: .5rem 0; }
  .main-nav a::after { content: ""; position: absolute; left: 0; right: 100%; bottom: .2rem; height: 1px; background: var(--copper); transition: right .25s ease; }
  .main-nav a:hover::after { right: 0; }
  .header-action { justify-self: end; display: flex; align-items: center; gap: .65rem; font-size: .78rem; font-weight: 600; }
  .header-action span { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border: 1px solid var(--charcoal); border-radius: 50%; transition: .25s ease; }
  .header-action:hover span { background: var(--charcoal); color: var(--white); transform: rotate(45deg); }
  .menu-button { display: none; border: 0; background: transparent; padding: .7rem; }
  .menu-button i { display: block; width: 22px; height: 1px; background: var(--charcoal); margin: 5px 0; transition: .25s ease; }

  .hero {
    position: relative; min-height: 860px; padding-top: 150px; overflow: hidden;
    background:
      linear-gradient(90deg, rgba(173,106,69,.06) 1px, transparent 1px) 0 0 / 11.11% 100%,
      var(--cream);
  }
  .hero-glow {
    position: absolute; width: 700px; height: 700px; border-radius: 50%;
    right: -240px; top: -210px; background: rgba(173,106,69,.15); filter: blur(110px);
  }
  .hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.08fr .92fr; gap: clamp(3rem, 7vw, 8rem); align-items: center; }
  .hero-copy { padding: 3rem 0 5rem; }
  .hero h1 {
    max-width: 760px; margin-top: 1.6rem; font-family: var(--font-display); font-weight: 300;
    font-size: clamp(4rem, 7.3vw, 7.4rem); line-height: .88; letter-spacing: -.06em;
  }
  .hero h1 em { display: block; color: var(--copper); font-weight: 300; }
