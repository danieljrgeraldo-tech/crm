---
import SiteLayout from "../layouts/SiteLayout.astro";
import OperationJourney from "../components/product/OperationJourney.astro";
import AdminDashboard from "../components/product/AdminDashboard.astro";
import ProductShowcase from "../components/product/ProductShowcase.astro";
import HumanizedAIDemo from "../components/product/HumanizedAIDemo.astro";
import FollowUpDemo from "../components/product/FollowUpDemo.astro";

const whatsappUrl =
  "https://wa.me/5548998493150?text=Ol%C3%A1%2C%20Daniel.%20Vi%20sua%20apresenta%C3%A7%C3%A3o%20sobre%20atendimento%20com%20IA%20e%20gostaria%20de%20entender%20como%20isso%20poderia%20funcionar%20na%20minha%20empresa.";

const navItems = [
  ["Operação", "#operacao"],
  ["Controle", "#controle"],
  ["Sistema", "#produto"],
  ["Recursos", "#recursos"],
  ["Implantação", "#implantacao"],
] as const;
---

<SiteLayout
  title="Daniel Junior | Operação de Atendimento com IA"
  description="Versão experimental da operação de atendimento com IA, CRM, Kanban, distribuição comercial e follow-up."
  robots="noindex, nofollow"
  canonicalUrl="https://redesign-ia-site-v2-test.daniel-junior-landing.pages.dev/"
>
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

  <header class="site-header" data-header>
    <div class="shell header-inner">
      <a class="brand" href="#inicio" aria-label="Daniel Junior, início">
        <span class="brand-mark" aria-hidden="true">✦</span>
        <span><strong>Daniel Junior</strong><small>Automação com IA</small></span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><span class="sr-only">Abrir menu</span><i></i><i></i></button>
      <nav id="main-nav" class="main-nav" aria-label="Navegação principal">
        {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
      <a class="nav-cta" href={whatsappUrl} target="_blank" rel="noreferrer">Falar sobre minha operação <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main id="conteudo">
    <section id="inicio" class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow glow-one" aria-hidden="true"></div>
      <div class="hero-glow glow-two" aria-hidden="true"></div>
      <div class="shell hero-layout">
        <div class="hero-copy">
          <p class="eyebrow dark" data-reveal><i></i> Atendimento, CRM e vendas no mesmo fluxo</p>
          <h1 data-reveal>Tenha inteligência artificial trabalhando <span>diretamente no seu WhatsApp.</span></h1>
          <p class="hero-lead" data-reveal>Ela responde, qualifica, registra no CRM, distribui a oportunidade para o vendedor certo e acompanha o próximo passo.</p>
          <div class="hero-actions" data-reveal>
            <a class="button primary" href={whatsappUrl} target="_blank" rel="noreferrer">Falar sobre minha operação <span aria-hidden="true">↗</span></a>
            <a class="button secondary" href="#operacao">Ver a operação <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-proof" data-reveal>
            <span><i>✓</i> Atendimento natural</span><span><i>✓</i> CRM atualizado</span><span><i>✓</i> Follow-up automático</span>
          </div>
        </div>

        <div class="chat-preview" data-reveal aria-label="Demonstração de conversa atendida por inteligência artificial">
          <header>
            <div><span class="brand-mark small">✦</span><span><small>CENTRAL DE ATENDIMENTO</small><strong>IA atendendo agora</strong></span></div>
            <i></i>
          </header>
          <div class="contact">
            <img src="/images/people/mariana.jpg" alt="" width="64" height="64" />
            <span><strong>Mariana Costa</strong><small>WhatsApp · online agora</small></span>
            <b>Novo lead</b>
          </div>
          <div class="chat-flow">
            <div class="message client">Quero comprar no atacado. Como funcionam as condições?<time>10:24</time></div>
            <div class="ai-state"><i></i><span><strong>IA analisando a intenção</strong><small>Interesse em compra no atacado</small></span></div>
            <div class="message ai"><small>RESPOSTA AUTOMÁTICA</small>Claro. Qual quantidade você pretende comprar por mês?<time>10:24 · ✓✓</time></div>
            <div class="message client short">Em torno de 150 peças.<time>10:25</time></div>
            <div class="qualified"><i>✦</i><span><small>QUALIFICAÇÃO CONCLUÍDA</small><strong>Atacado · 150 peças · Alta intenção</strong></span><b>Pronta</b></div>
          </div>
        </div>
      </div>
    </section>

    <section id="operacao" class="operation-section">
      <div class="shell">
        <div class="section-heading dark-heading">
          <div><p class="eyebrow dark" data-reveal>A OPERAÇÃO ACONTECENDO</p><h2 data-reveal>Da primeira mensagem ao próximo passo.</h2></div>
          <p data-reveal>A IA entende o contexto, registra os dados, cria a oportunidade, escolhe o responsável e deixa o retorno programado.</p>
        </div>
        <div class="operation-visual" data-reveal><OperationJourney /></div>
      </div>
    </section>

    <section id="controle" class="admin-section">
      <div class="shell human-grid">
        <div class="human-copy">
          <p class="eyebrow" data-reveal>CONVERSA NATURAL, OPERAÇÃO INTELIGENTE</p>
          <h2 data-reveal>A IA conversa sem parecer uma resposta automática.</h2>
          <p data-reveal>Ela entende áudio, reage às mensagens, mostra que está digitando e responde em partes, com o tom definido pela sua empresa.</p>
          <div class="human-features" data-reveal>
            <span><i>❤</i><b>Reage e acolhe</b><small>A conversa continua leve e natural.</small></span>
            <span><i>◖</i><b>Escuta antes de responder</b><small>Aguarda o cliente terminar e une o contexto.</small></span>
            <span><i>✦</i><b>Qualifica enquanto conversa</b><small>Transforma o diálogo em uma oportunidade organizada.</small></span>
          </div>
        </div>
        <div data-reveal><HumanizedAIDemo /></div>
      </div>
      <div class="shell">
        <div class="section-heading">
          <div><p class="eyebrow" data-reveal>CONTROLE PARA O GESTOR</p><h2 data-reveal>Você acompanha o que acontece dentro da sua operação.</h2></div>
          <p data-reveal>Veja quem está atendendo, quais leads estão parados, o trabalho de cada vendedor e o que precisa de atenção.</p>
        </div>
        <div class="admin-visual" data-reveal><AdminDashboard /></div>
      </div>
    </section>

    <section id="produto" class="product-section">
      <div class="product-grid" aria-hidden="true"></div>
      <div class="shell">
        <div class="section-heading dark-heading">
          <div><p class="eyebrow dark" data-reveal>CONTROLE COMERCIAL EM TEMPO REAL</p><h2 data-reveal>Um Kanban que avança junto com a conversa.</h2></div>
          <p data-reveal>A IA cria o card, registra a qualificação e move cada oportunidade para a etapa correta, sem preenchimento manual.</p>
        </div>
        <div class="showcase-wrap" data-reveal><ProductShowcase /></div>
      </div>
    </section>

    <section class="problems-section">
      <div class="shell problems-layout">
        <div>
          <p class="eyebrow" data-reveal>O QUE A OPERAÇÃO EVITA</p>
          <h2 data-reveal>O problema não é receber mensagens. É perder o controle delas.</h2>
        </div>
        <div class="problems-grid" data-reveal>
          <article><i>01</i><strong>Demora no primeiro atendimento</strong></article>
          <article><i>02</i><strong>Conversas esquecidas</strong></article>
          <article><i>03</i><strong>Informações espalhadas</strong></article>
          <article><i>04</i><strong>Leads sem responsável</strong></article>
          <article><i>05</i><strong>Retornos não realizados</strong></article>
          <article><i>06</i><strong>Gestor sem visão da equipe</strong></article>
        </div>
      </div>
      <div class="shell problem-result" data-reveal><span>✦</span><p>A operação conecta atendimento, CRM, equipe e follow-up no mesmo fluxo.</p></div>
    </section>

    <section id="recursos" class="resources-section">
      <div class="shell">
        <div class="section-heading">
          <div><p class="eyebrow" data-reveal>RECURSOS DA OPERAÇÃO</p><h2 data-reveal>Tudo o que sustenta o atendimento em um só lugar.</h2></div>
          <p data-reveal>Os recursos trabalham juntos. O cliente sente continuidade e o gestor mantém o controle.</p>
        </div>
        <div class="resources-grid" data-drawer-group>
          <article class="resource large channels inbox-resource" data-reveal>
            <div class="resource-copy"><div class="resource-icon">◎</div><small>TODOS OS CANAIS, UMA OPERAÇÃO</small><h3>Uma única caixa de entrada para todas as conversas.</h3><p>WhatsApp, Instagram, TikTok e chat do site chegam ao mesmo lugar. A equipe responde sem trocar de tela e a IA qualifica cada contato.</p></div>
            <div class="inbox-demo">
              <header><span><i></i> CAIXA DE ENTRADA</span><b>26 conversas</b></header>
              <div class="inbox-search">Buscar conversas, contatos ou tags</div>
              <article><span class="avatar-channel"><img src="/images/people/mariana.jpg" alt="" width="48" height="48"/><i class="wa">◉</i></span><span><strong>Mariana Costa</strong><small>Quero comprar no atacado</small></span><b>agora</b></article>
              <article><span class="avatar-channel"><img src="/images/people/fernanda.jpg" alt="" width="48" height="48"/><i class="ig">◎</i></span><span><strong>Fernanda Lima</strong><small>Vi o perfil e quero uma demonstração</small></span><b>2 min</b></article>
              <article><span class="avatar-channel"><img src="/images/people/lucas.jpg" alt="" width="48" height="48"/><i class="tk">♪</i></span><span><strong>Lucas Almeida</strong><small>Tenho uma equipe comercial</small></span><b>5 min</b></article>
              <footer><i></i><span><small>IA ANALISANDO</small><strong>Conversas organizadas em uma só fila</strong></span></footer>
            </div>
          </article>
          <article class="resource" data-reveal><div class="resource-icon">✦</div><small>QUALIFICAÇÃO</small><h3>Regras definidas para sua empresa.</h3><p>A IA identifica perfil, interesse, volume e o próximo passo.</p><div class="mini-flow"><span>Nova mensagem</span><i>→</i><b>Qualificado</b></div></article>
          <article class="resource large routing-resource" data-reveal>
            <div class="resource-copy"><div class="resource-icon">⇄</div><small>DISTRIBUIÇÃO</small><h3>O lead chega ao responsável certo.</h3><p>A IA compara setor, especialidade, carteira e posição no rodízio antes de encaminhar.</p></div>
            <div class="routing-demo">
              <header>Nova conversa qualificada <b>Distribuindo...</b></header>
              <div class="qualified-lead"><img src="/images/people/mariana.jpg" alt="" width="54" height="54"/><span><small>LEAD QUALIFICADO</small><strong>Mariana Costa</strong><em>Atacado · 150 peças · Alta intenção</em></span><b>Pronta</b></div>
              <i class="route-arrow">↓</i>
              <div class="sellers"><article><img src="/images/people/amanda.jpg" alt=""/><strong>Camila</strong><small>Varejo</small></article><article class="selected"><b>Melhor opção</b><img src="/images/people/rafael.jpg" alt=""/><strong>Rafael</strong><small>Atacado</small></article><article><img src="/images/people/lucas.jpg" alt=""/><strong>Lucas</strong><small>São Paulo</small></article></div>
              <footer>✓ <strong>Rafael recebeu todo o histórico</strong></footer>
            </div>
          </article>
          <article class="resource large followup-resource" data-reveal>
            <div class="resource-copy"><div class="resource-icon">◷</div><small>FOLLOW-UP</small><h3>A IA retoma o contato sem depender da memória da equipe.</h3><p>O lead parado recebe a próxima mensagem no horário definido e volta para o responsável quando responder.</p></div>
            <FollowUpDemo />
          </article>
          <article class="resource large memory-resource" data-reveal>
            <div class="resource-copy"><div class="resource-icon">◫</div><small>MEMÓRIA</small><h3>A conversa continua exatamente de onde parou.</h3><p>O histórico acompanha o lead e mantém contexto, preferências e decisões disponíveis.</p></div>
            <ol class="memory-steps" data-scroll-select>
              <li><i>01</i><span><small>ÚLTIMO ATENDIMENTO</small><strong>150 peças para a Região Sul</strong><p>Volume e região permanecem registrados.</p></span></li>
              <li><i>02</i><span><small>QUANDO O LEAD VOLTA</small><strong>A equipe recebe todo o contexto.</strong><p>Ninguém precisa perguntar tudo de novo.</p></span></li>
              <li><i>03</i><span><small>PRÓXIMO PASSO</small><strong>A negociação continua sem perder o raciocínio.</strong><p>A IA e o vendedor sabem o que já foi combinado.</p></span></li>
            </ol>
          </article>
          <article class="resource" data-reveal><div class="resource-icon">✓</div><small>RASTREABILIDADE</small><h3>Cada ação deixa um registro.</h3><p>Respostas, movimentações, responsáveis e próximos passos ficam no histórico.</p><div class="mini-list"><span><i></i>CRM atualizado</span><span><i></i>Vendedor notificado</span></div></article>
          <article class="resource" data-reveal><div class="resource-icon">⌁</div><small>PERMISSÕES</small><h3>O administrador define os limites.</h3><p>Conversas, mensagens e contatos não são apagados sem autorização.</p><div class="mini-lock">Proteção administrativa ativa <b>✓</b></div></article>
          <article class="resource large destinations" data-reveal><div class="resource-icon">↗</div><small>PRÓXIMO PASSO</small><h3>Você escolhe como cada qualificação termina.</h3><p>A oportunidade pode seguir para agendamento, ligação, call ou mensagem direta ao vendedor.</p><div><span>▦ Agendamento</span><span>☎ Ligação</span><span>◫ Call</span><span>✉ Mensagem</span></div></article>
        </div>
      </div>
    </section>

    <section id="daniel" class="daniel-section">
      <div class="shell daniel-layout">
        <div class="daniel-photo" data-reveal>
          <img src="/images/daniel-secondary.webp" alt="Daniel Junior, gestor de automação com inteligência artificial" width="1120" height="1400" loading="lazy" decoding="async" />
          <div><i></i><span><small>RESPONSÁVEL PELA OPERAÇÃO</small><strong>Você fala diretamente comigo</strong></span></div>
        </div>
        <div class="daniel-copy">
          <p class="eyebrow" data-reveal>QUEM IMPLEMENTA</p>
          <h2 data-reveal>Quem sou e o que posso fazer pela sua empresa?</h2>
          <p data-reveal>Eu sou Daniel Junior. Organizo operações comerciais usando atendimento, automação, CRM, inteligência artificial e integração.</p>
          <p data-reveal>Mapeio como sua equipe trabalha, configuro a estrutura, testo os cenários reais e acompanho os ajustes depois da implantação.</p>
          <div class="daniel-note" data-reveal><span>✦</span><p>Sua empresa não recebe apenas um chatbot. Recebe uma operação configurada de acordo com seus processos, sua equipe e suas regras.</p></div>
          <a class="button dark-button" href={whatsappUrl} target="_blank" rel="noreferrer" data-reveal>Conversar com Daniel <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section id="implantacao" class="process-section">
      <div class="shell">
        <div class="section-heading">
          <div><p class="eyebrow" data-reveal>COMO FUNCIONA A IMPLANTAÇÃO</p><h2 data-reveal>Quatro etapas para colocar a operação em funcionamento.</h2></div>
          <p data-reveal>Começamos pelo atendimento atual, validamos o funcionamento e acompanhamos a entrada em operação.</p>
        </div>
        <div class="process-grid" data-drawer-group>
          <article data-reveal><span>01</span><i>↳</i><h3>Entendimento</h3><p>Canais, equipe, atendimento e processo comercial.</p></article>
          <article data-reveal><span>02</span><i>⌘</i><h3>Estruturação</h3><p>CRM, etapas, regras, responsáveis, integrações e automações.</p></article>
          <article data-reveal><span>03</span><i>✓</i><h3>Testes</h3><p>Respostas, distribuição, registros e follow-up em cenários reais.</p></article>
          <article data-reveal><span>04</span><i>↗</i><h3>Acompanhamento</h3><p>Monitoramento inicial, ajustes e evolução da operação.</p></article>
        </div>
      </div>
    </section>

    <section class="applications-section">
      <div class="shell">
        <div class="applications-heading"><div><p class="eyebrow" data-reveal>PARA EMPRESAS QUE VENDEM POR CONVERSA</p><h2 data-reveal>Aplicações por tipo de negócio.</h2></div><p data-reveal>A estrutura acompanha as regras, o atendimento e o processo comercial de cada empresa.</p></div>
        <div class="segments-grid" data-drawer-group>
          <article data-reveal><i>01</i><small>VENDAS POR VOLUME</small><strong>Atacado e distribuição</strong><span>Qualifica quantidade, região e prazo antes de distribuir.</span><div><b>150 peças</b><em>→</em><b>Vendedor certo</b></div></article>
          <article data-reveal><i>02</i><small>AGENDAMENTOS</small><strong>Clínicas e serviços</strong><span>Entende a necessidade, responde dúvidas e organiza a agenda.</span><div><b>Interesse</b><em>→</em><b>Agendamento</b></div></article>
          <article data-reveal><i>03</i><small>PERFIL DO CLIENTE</small><strong>Imobiliárias</strong><span>Identifica orçamento, região e tipo de imóvel procurado.</span><div><b>Perfil completo</b><em>→</em><b>Corretor certo</b></div></article>
          <article data-reveal><i>04</i><small>VENDA CONSULTIVA</small><strong>Varejo consultivo</strong><span>Acompanha orçamento, objeções e momento de decisão.</span><div><b>Orçamento</b><em>→</em><b>Follow-up</b></div></article>
        </div>
      </div>
    </section>

    <section id="contato" class="final-cta">
      <div class="final-glow" aria-hidden="true"></div>
      <div class="shell final-content">
        <p class="eyebrow dark" data-reveal>PRÓXIMO PASSO</p>
        <h2 data-reveal>Quer entender como isso funcionaria na sua empresa?</h2>
        <p data-reveal>Você mostra como sua operação funciona hoje, e eu explico onde atendimento, CRM, distribuição e follow-up podem ser organizados.</p>
        <a class="button primary" href={whatsappUrl} target="_blank" rel="noreferrer" data-reveal>Falar sobre minha operação <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-layout">
      <div class="brand"><span class="brand-mark small">✦</span><span><strong>Daniel Junior</strong><small>Automação com IA</small></span></div>
      <p>Atendimento, CRM e automação gerenciados.</p>
      <div><a href="#inicio">Voltar ao topo ↑</a><small>© 2026 Daniel Junior</small></div>
    </div>
  </footer>

  <script is:inline>
    document.documentElement.classList.add("motion-ready");
    const header = document.querySelector("[data-header]");
    const menuButton = document.querySelector(".menu-toggle");
    const menu = document.querySelector(".main-nav");
    const closeMenu = () => {
      menuButton?.setAttribute("aria-expanded", "false");
      menu?.classList.remove("is-open");
    };
    menuButton?.addEventListener("click", () => {
      const open = menuButton.getAttribute("aria-expanded") === "true";
      menuButton.setAttribute("aria-expanded", String(!open));
      menu?.classList.toggle("is-open", !open);
    });
    menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    window.addEventListener("scroll", () => header?.classList.toggle("is-scrolled", window.scrollY > 24), { passive: true });
    const reveal = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add("is-visible");
      reveal.unobserve(entry.target);
    }), { threshold: .1, rootMargin: "0px 0px -6% 0px" });
    document.querySelectorAll("[data-reveal]").forEach((item) => reveal.observe(item));
    const selectGroups = document.querySelectorAll("[data-scroll-select], .journey-steps");
    const updateScrollSelection = () => {
      if (window.innerWidth > 760) return;
      const center = window.innerHeight * .52;
      selectGroups.forEach((group) => {
        const items = Array.from(group.children);
        let nearest = null;
        let distance = Infinity;
        items.forEach((item) => {
          const box = item.getBoundingClientRect();
          const current = Math.abs((box.top + box.height / 2) - center);
          if (current < distance) { distance = current; nearest = item; }
        });
        items.forEach((item) => item.classList.toggle("is-scroll-active", item === nearest));
      });
    };
    window.addEventListener("scroll", updateScrollSelection, { passive: true });
    window.addEventListener("resize", updateScrollSelection);
    updateScrollSelection();
  </script>
</SiteLayout>

<style>
  :global(:root){--shell:min(1180px,calc(100vw - 48px));--dark:#080a10;--dark-2:#10131d;--purple:#7659ef;--blue:#5796f5;--green:#43cf93;--surface:#f2f3f6;--surface-2:#e7eaf0;--text:#171a21;--muted:#727986}
  :global(html){scroll-behavior:smooth;background:var(--dark)}
  :global(body){overflow-x:hidden;background:var(--surface);color:var(--text);font-family:"Geist Sans Variable",system-ui,sans-serif}
  :global(.shell){width:var(--shell);margin-inline:auto}
  :global(.sr-only){position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  :global(.skip-link){position:fixed;top:8px;left:8px;z-index:1000;padding:.7rem 1rem;transform:translateY(-150%);border-radius:8px;color:#fff;background:#7659ef}:global(.skip-link:focus){transform:none}
