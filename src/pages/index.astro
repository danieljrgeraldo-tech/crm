---
import SiteLayout from "../layouts/SiteLayout.astro";
import HeroDemo from "../components/product/HeroDemo.astro";
import ProductShowcase from "../components/product/ProductShowcase.astro";
import FollowUpDemo from "../components/product/FollowUpDemo.astro";

const whatsappUrl =
  "https://wa.me/5548998493150?text=Ol%C3%A1%2C%20Daniel.%20Quero%20entender%20como%20essa%20opera%C3%A7%C3%A3o%20pode%20funcionar%20na%20minha%20empresa.";

const navItems = [
  ["Como funciona", "#produto"],
  ["Rodízio", "#distribuicao"],
  ["Follow-up", "#follow-up"],
  ["Implantação", "#implantacao"],
] as const;

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Daniel Junior — Automação com IA",
  url: "https://danieljunior.com.br/",
  description:
    "Implantação e acompanhamento de atendimento com inteligência artificial, CRM, Kanban, distribuição de conversas e follow-up.",
  areaServed: "BR",
  founder: { "@type": "Person", name: "Daniel Junior" },
};
---

<SiteLayout
  title="Daniel Junior | Inteligência Artificial no WhatsApp"
  description="Inteligência artificial para atender clientes, organizar o CRM, distribuir conversas entre vendedores e fazer follow-up."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

  <header class="site-header" data-header>
    <div class="shell header-inner">
      <a class="brand" href="#inicio">
        <span class="brand-mark" aria-hidden="true">D</span>
        <span class="brand-copy"><strong>Daniel Junior</strong><small>Automação com IA</small></span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span class="sr-only">Abrir menu</span><i></i><i></i>
      </button>

      <nav id="main-nav" class="main-nav" aria-label="Navegação principal">
        {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>

      <a class="nav-cta" href={whatsappUrl} target="_blank" rel="noreferrer">Falar sobre minha operação <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main id="conteudo">
    <section id="inicio" class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-light hero-light-one" aria-hidden="true"></div>
      <div class="hero-light hero-light-two" aria-hidden="true"></div>

      <div class="shell hero-copy">
        <div class="eyebrow dark" data-reveal><i></i> Atendimento, CRM e vendas no mesmo fluxo</div>
        <h1 data-reveal>Tenha inteligência artificial trabalhando <span>diretamente no seu WhatsApp.</span></h1>
        <p data-reveal>
          Ela conversa com seus clientes, entende o que cada pessoa precisa e entrega
          oportunidades organizadas para sua equipe continuar.
        </p>
        <div class="hero-actions" data-reveal>
          <a class="button button-primary" href="#produto">Ver como funciona <span aria-hidden="true">↓</span></a>
          <a class="button button-ghost" href={whatsappUrl} target="_blank" rel="noreferrer">Falar sobre minha operação <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="shell hero-product" data-reveal data-parallax="0.025">
        <HeroDemo />
      </div>

      <div class="flow-strip" aria-label="Fluxo da operação">
        <div class="shell flow-intro">
          <p class="eyebrow dark">UMA OPERAÇÃO CONECTADA</p>
          <h2>Da primeira mensagem ao próximo passo.</h2>
          <p>Cada etapa acontece no momento certo, sem depender de planilhas ou memória.</p>
        </div>
        <div class="shell flow-items">
          <div><i>01</i><span><strong>Cliente chama</strong><small>Uma conversa entra pelo WhatsApp</small></span></div>
          <div><i>02</i><span><strong>IA atende</strong><small>Responde e entende o interesse</small></span></div>
          <div><i>03</i><span><strong>CRM organiza</strong><small>Dados e etapa são atualizados</small></span></div>
          <div><i>04</i><span><strong>Vendedor recebe</strong><small>Oportunidade pronta e com histórico</small></span></div>
          <div><i>05</i><span><strong>Sistema acompanha</strong><small>O retorno acontece no horário certo</small></span></div>
        </div>
      </div>
    </section>

    <section id="daniel" class="daniel-section">
      <div class="shell daniel-grid">
        <div class="daniel-photo" data-reveal>
          <div class="photo-light" aria-hidden="true"></div>
          <img
            src="/images/daniel-secondary.webp"
            alt="Daniel Junior, gestor de automação com inteligência artificial"
            width="1120"
            height="1400"
            loading="lazy"
            decoding="async"
          />
          <div class="photo-status"><i></i><span><small>ACOMPANHAMENTO</small><strong>Operação gerenciada</strong></span></div>
        </div>

        <div class="daniel-copy">
          <p class="eyebrow" data-reveal>QUEM IMPLEMENTA</p>
          <h2 data-reveal>Eu sou Daniel Junior. Gestor de automação com IA.</h2>
          <p data-reveal>
            Eu desenho e gerencio operações de atendimento que conectam WhatsApp, inteligência artificial,
            CRM e equipe comercial. Meu trabalho começa entendendo como a sua empresa realmente vende.
          </p>
          <p data-reveal>
            Depois, organizo o processo, implanto a tecnologia e acompanho o uso no dia a dia.
            Você fala comigo diretamente — da primeira conversa aos ajustes da operação.
          </p>
          <div class="daniel-points" data-reveal>
            <span><i>01</i><b>Implantação completa</b><small>Estrutura conectada à rotina da empresa.</small></span>
            <span><i>02</i><b>Ajustes no atendimento</b><small>Fluxos revistos conforme a equipe usa.</small></span>
            <span><i>03</i><b>Suporte e evolução</b><small>Acompanhamento para a operação continuar melhorando.</small></span>
          </div>
          <a class="text-link" href={whatsappUrl} target="_blank" rel="noreferrer" data-reveal>Conversar com Daniel <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section id="produto" class="product-section">
      <div class="product-mesh" aria-hidden="true"></div>
      <div class="shell">
        <div class="section-heading dark-heading">
          <div>
            <p class="eyebrow dark" data-reveal>VEJA O PRODUTO FUNCIONANDO</p>
            <h2 data-reveal>Veja a operação por dentro.</h2>
          </div>
          <p data-reveal>Alterne entre a caixa de entrada, o pipeline comercial e as automações que trabalham nos bastidores.</p>
        </div>
        <div data-reveal>
          <ProductShowcase />
        </div>
      </div>
    </section>

    <section id="distribuicao" class="routing-section">
      <div class="shell routing-grid">
        <div class="routing-copy">
          <p class="eyebrow" data-reveal>RODÍZIO DA EQUIPE</p>
          <h2 data-reveal>O cliente certo chega à pessoa certa.</h2>
          <p data-reveal>
            Regras de região, produto e carteira definem quem continua o atendimento.
            A distribuição deixa de ser uma decisão manual.
          </p>
          <ul data-reveal>
            <li><i>✓</i> Distribuição equilibrada entre vendedores</li>
            <li><i>✓</i> Regras por região, produto ou tipo de cliente</li>
            <li><i>✓</i> Histórico entregue junto com a conversa</li>
          </ul>
        </div>

        <div class="routing-demo" data-reveal aria-label="Exemplo de distribuição automática">
          <div class="routing-top"><span>Nova conversa qualificada</span><b>Distribuindo...</b></div>
          <div class="routing-source"><img src="/images/people/mariana.jpg" alt="" width="72" height="72" /><div><small>CLIENTE</small><strong>Mariana Costa</strong><span>Atacado · Região Sul · Alta intenção</span></div></div>
          <div class="routing-line"><span></span><i>↓</i><span></span></div>
          <div class="seller-grid">
            <article><img src="/images/people/amanda.jpg" alt="" width="72" height="72" /><strong>Camila</strong><small>Varejo</small></article>
            <article class="selected"><span>Melhor opção</span><img src="/images/people/rafael.jpg" alt="" width="72" height="72" /><strong>Rafael</strong><small>Atacado · Sul</small></article>
            <article><img src="/images/people/lucas.jpg" alt="" width="72" height="72" /><strong>Lucas</strong><small>São Paulo</small></article>
          </div>
          <div class="routing-result"><i>✓</i><span><small>CONVERSA ENCAMINHADA</small><strong>Rafael recebeu todo o histórico</strong></span><time>agora</time></div>
        </div>
      </div>
    </section>

    <section id="follow-up" class="followup-section">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow" data-reveal>FOLLOW-UP AUTOMÁTICO</p>
            <h2 data-reveal>O retorno acontece na hora combinada.</h2>
          </div>
          <p data-reveal>O próximo contato já sai da conversa com data, mensagem e responsável definidos.</p>
        </div>
        <div class="followup-wrapper" data-reveal>
          <FollowUpDemo />
        </div>
      </div>
    </section>

    <section id="controle" class="control-section">
      <div class="control-grid-bg" aria-hidden="true"></div>
      <div class="shell control-grid">
        <div class="control-copy">
          <p class="eyebrow dark" data-reveal>TUDO FICA REGISTRADO</p>
          <h2 data-reveal>Cada decisão deixa um registro.</h2>
          <p data-reveal>Veja quando algo mudou, por que mudou e quem assumiu o próximo passo. Gestão sem depender de relatos.</p>
          <div class="control-stats" data-reveal>
            <div><strong>24</strong><span>conversas hoje</span></div>
            <div><strong>68%</strong><span>qualificadas</span></div>
            <div><strong>4 s</strong><span>para responder</span></div>
          </div>
        </div>

        <div class="history-panel" data-reveal aria-label="Histórico de uma conversa">
          <header><div><img src="/images/people/mariana.jpg" alt="" width="64" height="64" /><span><strong>Mariana Costa</strong><small>O que aconteceu desde a primeira mensagem</small></span></div><b>Qualificado</b></header>
          <ol>
            <li><i class="message-icon">✦</i><div><small>RESPOSTA</small><strong>A dúvida foi respondida na hora.</strong><p>A IA explicou as condições de atacado.</p></div><time>10:24</time></li>
            <li><i class="data-icon">✓</i><div><small>ORGANIZAÇÃO</small><strong>Os dados entraram no CRM.</strong><p>150 peças · Região Sul · Alta intenção.</p></div><time>10:25</time></li>
            <li><i class="move-icon">→</i><div><small>ETAPA COMERCIAL</small><strong>A oportunidade virou “Qualificado”.</strong><p>O Kanban foi atualizado sozinho.</p></div><time>10:25</time></li>
            <li><i class="person-icon">RA</i><div><small>DISTRIBUIÇÃO</small><strong>Rafael recebeu a conversa.</strong><p>Cliente, dados e histórico chegaram juntos.</p></div><time>10:25</time></li>
            <li><i class="clock-icon">◷</i><div><small>PRÓXIMO PASSO</small><strong>O retorno ficou agendado.</strong><p>O sistema chama amanhã às 09:00.</p></div><time>10:26</time></li>
          </ol>
        </div>
      </div>
    </section>

    <section id="implantacao" class="process-section">
      <div class="shell">
        <div class="process-intro">
          <p class="eyebrow" data-reveal>COMO A IMPLANTAÇÃO FUNCIONA</p>
          <h2 data-reveal>Da rotina atual para uma operação funcionando.</h2>
          <p data-reveal>Uma implantação em quatro etapas, com começo, validação e acompanhamento claros.</p>
        </div>
        <div class="process-grid">
          <article data-reveal><span>01</span><i>↳</i><h3>Entender a operação</h3><p>Canais, equipe, dúvidas e etapas de venda.</p></article>
          <article data-reveal><span>02</span><i>⌘</i><h3>Configurar o sistema</h3><p>Atendimento, CRM, Kanban e regras do rodízio.</p></article>
          <article data-reveal><span>03</span><i>✓</i><h3>Colocar para funcionar</h3><p>Testes, treinamento e entrada em operação.</p></article>
          <article data-reveal><span>04</span><i>↗</i><h3>Acompanhar e melhorar</h3><p>Suporte, ajustes e evolução contínua.</p></article>
        </div>
      </div>
    </section>

    <section class="segments-section">
      <div class="shell">
        <div class="segments-heading">
          <div>
            <p class="eyebrow" data-reveal>PARA EMPRESAS QUE VENDEM PELO WHATSAPP</p>
            <h2 data-reveal>Funciona onde a conversa precisa virar atendimento.</h2>
          </div>
          <p data-reveal>A estrutura se adapta ao processo comercial da sua empresa, sem exigir conhecimento técnico da equipe.</p>
        </div>
        <div class="segments-grid">
          <article data-reveal><i>01</i><strong>Atacado e distribuição</strong><span>Entende volume e região.</span><div><b>150 peças</b><em>→</em><b>Vendedor Sul</b></div></article>
          <article data-reveal><i>02</i><strong>Clínicas e serviços</strong><span>Responde dúvidas e organiza a agenda.</span><div><b>Interesse</b><em>→</em><b>Agendamento</b></div></article>
          <article data-reveal><i>03</i><strong>Imobiliárias</strong><span>Identifica perfil e tipo de imóvel.</span><div><b>Perfil</b><em>→</em><b>Corretor certo</b></div></article>
          <article data-reveal><i>04</i><strong>Varejo consultivo</strong><span>Acompanha orçamento e decisão.</span><div><b>Orçamento</b><em>→</em><b>Follow-up</b></div></article>
        </div>
      </div>
    </section>

    <section id="contato" class="final-cta">
      <div class="final-grid" aria-hidden="true"></div>
      <div class="final-glow" aria-hidden="true"></div>
      <div class="shell final-content">
        <div class="eyebrow dark" data-reveal><i></i> Demonstração aplicada à sua operação</div>
        <h2 data-reveal>Quer ver isso funcionando na sua empresa?</h2>
        <p data-reveal>Mostre como sua equipe atende hoje. Daniel apresenta como o fluxo pode ser organizado.</p>
        <a class="button button-primary" href={whatsappUrl} target="_blank" rel="noreferrer" data-reveal>Falar sobre minha operação <span aria-hidden="true">↗</span></a>
        <small data-reveal>Conversa direta com Daniel Junior.</small>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-brand"><span class="brand-mark">D</span><span><strong>Daniel Junior</strong><small>Automação com IA</small></span></div>
      <p>Atendimento, CRM e automação gerenciados.</p>
      <div><a href="#inicio">Voltar ao topo ↑</a><span>© 2026 Daniel Junior</span></div>
    </div>
  </footer>

  <script>
    document.documentElement.classList.add("motion-ready");

    const header = document.querySelector<HTMLElement>("[data-header]");
    const menuButton = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const menu = document.querySelector<HTMLElement>(".main-nav");

    const closeMenu = () => {
      menuButton?.setAttribute("aria-expanded", "false");
      menu?.classList.remove("is-open");
      document.body.classList.remove("menu-open");
    };

    menuButton?.addEventListener("click", () => {
      const open = menuButton.getAttribute("aria-expanded") !== "true";
      menuButton.setAttribute("aria-expanded", String(open));
      menu?.classList.toggle("is-open", open);
      document.body.classList.toggle("menu-open", open);
    });
    menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => event.key === "Escape" && closeMenu());

    const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 18);
    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");

    if (reduceMotion || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }),
        { threshold: 0.08, rootMargin: "0px 0px -7% 0px" },
      );
      revealItems.forEach((item) => observer.observe(item));
    }

    if (!reduceMotion) {
      const parallaxItems = Array.from(document.querySelectorAll<HTMLElement>("[data-parallax]"));
      let frame = 0;
      const updateParallax = () => {
        frame = 0;
        parallaxItems.forEach((item) => {
          const speed = Number(item.dataset.parallax ?? 0);
          const rect = item.getBoundingClientRect();
          const centerDistance = rect.top + rect.height / 2 - window.innerHeight / 2;
          item.style.setProperty("--parallax-y", `${Math.max(-28, Math.min(28, centerDistance * speed))}px`);
        });
      };
      window.addEventListener("scroll", () => {
        if (!frame) frame = requestAnimationFrame(updateParallax);
      }, { passive: true });
      updateParallax();
    }
  </script>
</SiteLayout>

<style>
  :global(:root) {
    --bg-dark: #08090d;
    --bg-dark-2: #0e1016;
    --surface: #f4f5f7;
    --surface-2: #e9ebf0;
    --ink: #14171e;
    --muted: #727783;
    --muted-dark: #969baa;
    --line: #d9dde5;
    --line-dark: rgba(255,255,255,.11);
    --violet: #7257eb;
    --blue: #4e7cf5;
    --green: #35bf81;
    --shell: min(1220px, calc(100vw - 64px));
    --font: "Geist Sans", "Inter", Arial, sans-serif;
  }
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; overflow-x: clip; background: var(--bg-dark); }
  :global(body) { margin: 0; overflow-x: clip; color: var(--ink); background: var(--surface); font-family: var(--font); font-size: 16px; line-height: 1.55; }
  :global(body.menu-open) { overflow: hidden; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(button) { font-family: inherit; }
  :global(.shell) { width: var(--shell); margin-inline: auto; }
  :global(.skip-link) { position: fixed; z-index: 100; left: 16px; top: 16px; padding: .7rem 1rem; border-radius: 8px; color: black; background: white; transform: translateY(-150%); }
  :global(.skip-link:focus) { transform: none; }
  :global(.sr-only) { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  :global(.eyebrow) { margin: 0; color: var(--violet); font-size: .68rem; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; }
  :global(.eyebrow.dark) { display: flex; align-items: center; gap: .6rem; color: #aea4cc; }
  :global(.eyebrow.dark i) { width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px rgba(53,191,129,.1); }
  :global(.button) { height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: .75rem; padding: 0 1.3rem; border: 1px solid transparent; border-radius: 10px; font-size: .84rem; font-weight: 700; transition: transform .25s ease, box-shadow .25s ease, background .25s ease; }
  :global(.button:hover) { transform: translateY(-2px); }
  :global(.button:focus-visible), :global(a:focus-visible), :global(button:focus-visible) { outline: 2px solid #8a73ff; outline-offset: 4px; }
  :global(.button-primary) { color: white; background: linear-gradient(135deg,#7657f1,#4f7cf6); box-shadow: 0 15px 38px rgba(101,82,232,.3), inset 0 1px rgba(255,255,255,.22); }
  :global(.button-primary:hover) { box-shadow: 0 20px 46px rgba(101,82,232,.42), inset 0 1px rgba(255,255,255,.22); }
  :global(.section-heading) { display: grid; grid-template-columns: 1.1fr .72fr; gap: clamp(3rem,8vw,8rem); align-items: end; }
  :global(.section-heading h2) { max-width: 720px; margin: .9rem 0 0; font-size: clamp(2.3rem,3.7vw,3.55rem); line-height: 1.04; letter-spacing: -.045em; font-weight: 620; }
  :global(.section-heading > p) { margin: 0; color: var(--muted); font-size: .98rem; line-height: 1.75; }

  .site-header { position: fixed; z-index: 70; inset: 0 0 auto; border-bottom: 1px solid transparent; transition: background .25s ease, border-color .25s ease, backdrop-filter .25s ease; }
  .site-header.is-scrolled { border-color: var(--line-dark); background: rgba(8,9,13,.78); backdrop-filter: blur(20px); }
  .header-inner { height: 74px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; }
  .brand { width: max-content; display: inline-flex; align-items: center; gap: .7rem; color: white; }
  .brand-mark { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 9px; color: white; background: linear-gradient(145deg,#7959f1,#4f78ed); box-shadow: inset 0 1px rgba(255,255,255,.3),0 8px 22px rgba(92,70,218,.25); font-size: .8rem; font-weight: 750; }
  .brand-copy { display: flex; flex-direction: column; line-height: 1.05; }
  .brand-copy strong { font-size: .83rem; } .brand-copy small { margin-top: .3rem; color: #777c8a; font-size: .5rem; letter-spacing: .13em; text-transform: uppercase; }
  .main-nav { display: flex; align-items: center; gap: 1.8rem; color: #9ea3af; font-size: .73rem; }
  .main-nav a { transition: color .2s ease; } .main-nav a:hover { color: white; }
  .nav-cta { justify-self: end; height: 39px; display: inline-flex; align-items: center; gap: .55rem; padding: 0 .9rem; border: 1px solid var(--line-dark); border-radius: 8px; color: #e7e8ed; background: rgba(255,255,255,.045); font-size: .68rem; font-weight: 650; }
  .menu-toggle { display: none; padding: .7rem; border: 0; background: transparent; }
  .menu-toggle i { width: 21px; height: 1px; display: block; margin: 5px 0; background: white; transform-origin: center; transition: transform .25s ease; }

  .hero { position: relative; overflow: hidden; padding: 148px 0 0; color: white; background: linear-gradient(180deg,#090a0f,#07080c 78%,#0c0e14); }
  .hero-grid, .control-grid-bg, .final-grid { position: absolute; inset: 0; opacity: .2; background-image: linear-gradient(rgba(255,255,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.055) 1px,transparent 1px); background-size: 72px 72px; mask-image: linear-gradient(to bottom,#000,transparent 82%); }
  .hero-light { position: absolute; border-radius: 50%; filter: blur(110px); pointer-events: none; }
  .hero-light-one { width: 520px; height: 520px; left: -250px; top: 280px; background: rgba(66,103,239,.13); }
  .hero-light-two { width: 560px; height: 560px; right: -260px; top: 80px; background: rgba(120,79,240,.14); }
