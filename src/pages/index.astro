---
import SiteLayout from "../layouts/SiteLayout.astro";

const demoUrl =
  "https://wa.me/5548998493150?text=" +
  encodeURIComponent(
    "Olá, Daniel. Quero agendar uma demonstração da operação de atendimento com IA."
  );

const navItems = [
  ["Produto", "#produto"],
  ["Recursos", "#recursos"],
  ["Como funciona", "#como-funciona"],
  ["Gestão", "#gestao"],
];

const conversationItems = [
  { initials: "MC", name: "Mariana Costa", text: "Quero conhecer as condições", time: "agora", active: true },
  { initials: "RA", name: "Rafael Alves", text: "Recebi a proposta, obrigado", time: "4 min" },
  { initials: "CB", name: "Camila Borges", text: "Vocês entregam para SC?", time: "8 min" },
  { initials: "LP", name: "Lucas Prado", text: "Preciso falar com vendas", time: "12 min" },
];

const kanbanColumns = [
  {
    title: "Novos contatos",
    count: "12",
    cards: [
      ["Mariana Costa", "Catálogo solicitado", "Novo", "MC"],
      ["Studio Alma", "Primeiro atendimento", "WhatsApp", "SA"],
    ],
  },
  {
    title: "Qualificados",
    count: "8",
    cards: [
      ["Grupo Essenza", "Volume confirmado", "Alta intenção", "GE"],
      ["Casa Horizonte", "Aguardando proposta", "Retorno hoje", "CH"],
    ],
  },
  {
    title: "Em negociação",
    count: "5",
    cards: [
      ["Mercado da Vila", "Proposta enviada", "Prioridade", "MV"],
      ["Lume Decor", "Condições alinhadas", "Follow-up", "LD"],
    ],
  },
  {
    title: "Fechados",
    count: "24",
    cards: [["Nativa Store", "Pedido confirmado", "Concluído", "NS"]],
  },
];

const capabilities = [
  "Atende em segundos",
  "Responde dúvidas",
  "Quebra objeções",
  "Qualifica contatos",
  "Atualiza o CRM",
  "Distribui conversas",
];

const steps = [
  ["01", "Mapeamento", "Canais, equipe, etapas e regras da operação."],
  ["02", "Implantação", "CRM, atendimento e automações configurados."],
  ["03", "Treinamento", "Equipe pronta para operar com clareza."],
  ["04", "Gestão contínua", "Acompanhamento, ajustes e evolução."],
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Daniel Junior — Gestão de Automação com IA",
  url: "https://danieljunior.com.br",
  description:
    "Inteligência Artificial para atendimento no WhatsApp, qualificação de contatos, CRM e distribuição comercial.",
  areaServed: "BR",
  serviceType: "Gestão de automação com IA para atendimento e vendas",
};
---

<SiteLayout
  title="Daniel Junior | Inteligência Artificial para WhatsApp"
  description="Tenha uma Inteligência Artificial atendendo clientes, qualificando contatos, atualizando o CRM e distribuindo conversas no WhatsApp."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

  <header class="site-header" data-header>
    <div class="shell header-inner">
      <a class="brand" href="#inicio">
        <span class="brand-mark" aria-hidden="true">D</span>
        <span class="brand-copy">
          <strong>Daniel Junior</strong>
          <small>Automação com IA</small>
        </span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span class="sr-only">Abrir menu</span>
        <i></i><i></i>
      </button>

      <nav id="main-nav" class="main-nav" aria-label="Navegação principal">
        {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>

      <a class="nav-cta" href={demoUrl} target="_blank" rel="noreferrer">
        Agendar demonstração <span aria-hidden="true">↗</span>
      </a>
    </div>
  </header>

  <main id="conteudo">
    <section id="inicio" class="hero">
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-two" aria-hidden="true"></div>

      <div class="shell hero-content">
        <div class="hero-badge" data-reveal>
          <span></span>
          IA para atendimento e vendas no WhatsApp
        </div>

        <h1 data-reveal>Tenha uma Inteligência Artificial trabalhando diretamente no seu WhatsApp.</h1>

        <p class="hero-subtitle" data-reveal>
          Ela atende clientes, responde dúvidas, quebra objeções, qualifica contatos,
          atualiza automaticamente o CRM e encaminha cada conversa para o vendedor certo.
        </p>

        <div class="hero-actions" data-reveal>
          <a class="button button-primary" href={demoUrl} target="_blank" rel="noreferrer">
            Agendar demonstração <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-secondary" href="#produto">
            Ver como funciona <span aria-hidden="true">↓</span>
          </a>
        </div>

        <div class="product-stage" data-parallax="0.035" data-reveal aria-hidden="true" inert>
          <div class="stage-glow" aria-hidden="true"></div>

          <div class="app-shell">
            <div class="app-topbar">
              <div class="app-brand">
                <i>DJ</i>
                <span>Central Comercial</span>
              </div>
              <div class="app-search">Buscar conversas, contatos ou etiquetas</div>
              <div class="app-top-actions">
                <span class="online-dot"></span>
                <b>Operação ativa</b>
                <i>DA</i>
              </div>
            </div>

            <div class="app-body">
              <aside class="app-rail" aria-hidden="true">
                <button class="rail-active">◫</button>
                <button>◇</button>
                <button>⌁</button>
                <button>◎</button>
                <span></span>
                <button>⚙</button>
              </aside>

              <div class="conversation-list">
                <div class="list-head">
                  <div>
                    <small>CAIXA DE ENTRADA</small>
                    <strong>Conversas</strong>
                  </div>
                  <button>＋</button>
                </div>
                <div class="list-tabs">
                  <span class="active">Todas <b>17</b></span>
                  <span>Minhas <b>6</b></span>
                </div>
                <div class="conversation-items">
                  {conversationItems.map((item, index) => (
                    <article class:list={{ active: item.active }}>
                      <i class={`avatar av-${index + 1}`}>{item.initials}</i>
                      <div>
                        <div class="conversation-name">
                          <strong>{item.name}</strong><time>{item.time}</time>
                        </div>
                        <p>{item.text}</p>
                        <span>WhatsApp</span>
                      </div>
                    </article>
                  ))}
                </div>
              </div>

              <div class="chat-panel">
                <div class="chat-head">
                  <div class="chat-person">
                    <i class="avatar av-1">MC</i>
                    <div><strong>Mariana Costa</strong><small>online agora</small></div>
                  </div>
                  <div class="chat-head-actions"><button>Histórico</button><button>•••</button></div>
                </div>
                <div class="chat-body">
                  <div class="chat-date">Hoje, 10:24</div>
                  <div class="message incoming">
                    <p>Olá! Vi o catálogo e quero entender as condições para atacado.</p>
                    <time>10:24</time>
                  </div>
                  <div class="ai-thinking"><span></span><span></span><span></span> IA analisando contexto</div>
                  <div class="message outgoing">
                    <span class="message-author">Assistente de IA</span>
                    <p>Claro, Mariana. Para indicar a condição correta, qual volume você pretende comprar por mês?</p>
                    <time>10:24 · ✓✓</time>
                  </div>
                  <div class="message incoming compact">
                    <p>Em torno de 150 peças.</p>
                    <time>10:25</time>
                  </div>
                  <div class="system-event">
                    <i>✓</i>
                    <span>Contato qualificado automaticamente</span>
                  </div>
                </div>
                <div class="composer">
                  <span>＋</span>
                  <p>Responder mensagem...</p>
                  <button>Enviar</button>
                </div>
              </div>

              <aside class="customer-panel">
                <div class="customer-head">
                  <i class="avatar av-1">MC</i>
                  <div><strong>Mariana Costa</strong><small>Cliente potencial</small></div>
                </div>
                <div class="score-card">
                  <div><small>INTENÇÃO DE COMPRA</small><strong>Alta</strong></div>
                  <span>92</span>
                </div>
                <div class="customer-block">
                  <small>ETAPA DO CRM</small>
                  <button><i></i> Qualificado <span>⌄</span></button>
                </div>
                <div class="customer-block">
                  <small>RESPONSÁVEL</small>
                  <button><b>RA</b> Rafael Alves <span>⌄</span></button>
                </div>
                <div class="customer-block">
                  <small>ETIQUETAS</small>
                  <div class="tag-list"><span>atacado</span><span>alta-intenção</span><span>150 peças</span></div>
                </div>
                <div class="customer-block activity">
                  <small>PRÓXIMA AÇÃO</small>
                  <p><i></i> Vendedor notificado</p>
                  <time>agora</time>
                </div>
              </aside>
            </div>
          </div>

          <div class="float-card float-ai" aria-hidden="true">
            <span class="spark">✦</span>
            <div><small>IA EM ATENDIMENTO</small><strong>Resposta em 4 segundos</strong></div>
            <i class="signal"><b></b><b></b><b></b></i>
          </div>

          <div class="float-card float-crm" aria-hidden="true">
            <span class="check">✓</span>
            <div><small>CRM ATUALIZADO</small><strong>Novo → Qualificado</strong></div>
          </div>

          <div class="float-card float-route" aria-hidden="true">
            <div class="route-avatars"><i>IA</i><span>→</span><i>RA</i></div>
            <div><small>DISTRIBUIÇÃO AUTOMÁTICA</small><strong>Enviado ao vendedor certo</strong></div>
          </div>
        </div>
      </div>
    </section>

    <section id="gestao" class="manager-section">
      <div class="shell manager-grid">
        <div class="manager-photo" data-reveal>
          <div class="photo-halo" aria-hidden="true"></div>
          <img
            src="/images/daniel-secondary.webp"
            alt="Daniel Junior, gestor de automação com IA"
            width="1120"
            height="1500"
            loading="lazy"
            decoding="async"
          />
          <div class="manager-status"><i></i> Operação acompanhada</div>
        </div>

        <div class="manager-copy">
          <p class="section-kicker" data-reveal>TECNOLOGIA + GESTÃO</p>
          <h2 data-reveal>Tecnologia pronta para vender mais.</h2>
          <p data-reveal>
            Daniel desenha, implanta e acompanha sua operação de atendimento.
            A IA trabalha. O CRM se mantém organizado. Sua equipe recebe cada oportunidade pronta para avançar.
          </p>
          <div class="manager-points" data-reveal>
            <span><i>01</i> Estratégia aplicada</span>
            <span><i>02</i> Implantação completa</span>
            <span><i>03</i> Gestão contínua</span>
          </div>
          <a class="inline-link" href={demoUrl} target="_blank" rel="noreferrer" data-reveal>
            Conhecer a operação <span>↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="capability-strip" aria-label="Capacidades da operação">
      <div class="capability-track">
        {[...capabilities, ...capabilities].map((item) => (
          <span><i>✦</i>{item}</span>
        ))}
      </div>
    </section>

    <section id="produto" class="product-section">
      <div class="product-ambient" aria-hidden="true"></div>
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="section-kicker" data-reveal>O CRM É O CENTRO DA OPERAÇÃO</p>
            <h2 data-reveal>Atendimento, vendas e follow-up. Tudo conectado.</h2>
          </div>
          <p data-reveal>
            Nenhuma conversa perdida. Nenhum cliente esquecido.
            Cada ação registrada automaticamente.
          </p>
        </div>

        <div class="product-tabs" role="tablist" aria-label="Visões do produto" data-reveal>
          <button id="tab-atendimento" role="tab" aria-selected="true" aria-controls="panel-atendimento" data-product-tab="atendimento">
            <span>01</span> Atendimento
          </button>
          <button id="tab-kanban" role="tab" aria-selected="false" aria-controls="panel-kanban" data-product-tab="kanban" tabindex="-1">
            <span>02</span> Kanban comercial
          </button>
          <button id="tab-automacoes" role="tab" aria-selected="false" aria-controls="panel-automacoes" data-product-tab="automacoes" tabindex="-1">
            <span>03</span> Automações
          </button>
        </div>

        <div class="product-view" data-reveal>
          <section id="panel-atendimento" role="tabpanel" aria-labelledby="tab-atendimento" data-product-panel="atendimento">
            <div class="view-toolbar">
              <div><i></i><i></i><i></i></div>
              <span>Central de atendimento</span>
              <small>Atualizado agora</small>
            </div>
            <div class="real-crm-shot">
              <img
                src="/images/crm/painel-atendimento.webp"
                alt="Central de atendimento em português com conversas, histórico, etiquetas e responsável"
                width="1800"
                height="1187"
                loading="lazy"
                decoding="async"
              />
              <div class="shot-highlight shot-highlight-one"><span>Histórico completo</span></div>
              <div class="shot-highlight shot-highlight-two"><span>Etiquetas automáticas</span></div>
            </div>
          </section>

          <section id="panel-kanban" role="tabpanel" aria-labelledby="tab-kanban" data-product-panel="kanban" hidden>
            <div class="view-toolbar">
              <div><i></i><i></i><i></i></div>
              <span>Pipeline comercial</span>
              <small>49 oportunidades</small>
            </div>
            <div class="kanban-view">
              <div class="kanban-topline">
                <div><strong>Oportunidades</strong><span>Visão geral da operação</span></div>
                <div><button>Todos os vendedores⌄</button><button>＋ Nova oportunidade</button></div>
              </div>
              <div class="kanban-grid">
                {kanbanColumns.map((column, columnIndex) => (
                  <div class="kanban-column">
                    <div class="kanban-column-head">
                      <span><i class={`column-dot dot-${columnIndex + 1}`}></i>{column.title}</span>
                      <b>{column.count}</b>
                    </div>
                    {column.cards.map((card) => (
                      <article>
                        <div class="kanban-card-head"><i>{card[3]}</i><small>{card[0]}</small><button>•••</button></div>
                        <strong>{card[1]}</strong>
                        <div><span>{card[2]}</span><time>Hoje</time></div>
                      </article>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </section>

          <section id="panel-automacoes" role="tabpanel" aria-labelledby="tab-automacoes" data-product-panel="automacoes" hidden>
            <div class="view-toolbar">
              <div><i></i><i></i><i></i></div>
              <span>Automações da operação</span>
              <small>6 fluxos ativos</small>
            </div>
            <div class="automation-view">
              <div class="automation-sidebar">
                <small>AUTOMAÇÕES</small>
                <strong>Qualificação de novos contatos</strong>
                <p>Executa quando uma nova conversa chega pelo WhatsApp.</p>
                <div><i></i> Fluxo ativo</div>
              </div>
              <div class="automation-canvas">
                <div class="canvas-grid" aria-hidden="true"></div>
                <div class="flow-line line-one" aria-hidden="true"></div>
                <div class="flow-line line-two" aria-hidden="true"></div>
                <div class="flow-line line-three" aria-hidden="true"></div>
                <article class="flow-node node-trigger">
                  <span class="node-icon whatsapp-node">W</span>
                  <div><small>GATILHO</small><strong>Nova mensagem</strong><p>WhatsApp</p></div>
                  <i></i>
                </article>
                <article class="flow-node node-ai">
                  <span class="node-icon ai-node">✦</span>
                  <div><small>INTELIGÊNCIA</small><strong>Analisar contato</strong><p>Intenção, perfil e objeções</p></div>
                  <i></i>
                </article>
                <article class="flow-node node-crm">
                  <span class="node-icon crm-node">◫</span>
                  <div><small>CRM</small><strong>Atualizar oportunidade</strong><p>Etapa + etiquetas + resumo</p></div>
                  <i></i>
                </article>
                <article class="flow-node node-route">
                  <span class="node-icon route-node">→</span>
                  <div><small>DISTRIBUIÇÃO</small><strong>Escolher vendedor</strong><p>Regra, região e disponibilidade</p></div>
                  <i></i>
                </article>
                <article class="flow-node node-finish">
                  <span class="node-icon finish-node">✓</span>
                  <div><small>CONCLUÍDO</small><strong>Oportunidade entregue</strong><p>Vendedor notificado</p></div>
                </article>
              </div>
            </div>
          </section>
        </div>
      </div>
    </section>

    <section id="recursos" class="features-section">
      <div class="shell">
        <div class="section-heading compact-heading">
          <div>
            <p class="section-kicker" data-reveal>A OPERAÇÃO TRABALHA SOZINHA</p>
            <h2 data-reveal>Mais controle. Menos tarefas manuais.</h2>
          </div>
          <p data-reveal>Automação onde gera resultado. Pessoas onde fazem diferença.</p>
        </div>

        <div class="bento-grid">
          <article class="bento-card followup-card" data-reveal>
            <div class="card-copy">
              <span class="feature-label">FOLLOW-UP AUTOMÁTICO</span>
              <h3>Nenhum cliente esquecido.</h3>
              <p>O próximo contato acontece no momento certo.</p>
            </div>
            <div class="followup-ui">
              <div class="followup-line" aria-hidden="true"></div>
              <div class="followup-step active"><i>✓</i><div><strong>Primeiro contato</strong><small>Hoje · 10:24</small></div><span>Concluído</span></div>
              <div class="followup-step"><i>2</i><div><strong>Retorno comercial</strong><small>Amanhã · 09:00</small></div><span>Agendado</span></div>
              <div class="followup-step"><i>3</i><div><strong>Reativação</strong><small>Em 3 dias</small></div><span>Automático</span></div>
            </div>
          </article>

          <article class="bento-card routing-card" data-reveal>
            <div class="card-copy">
              <span class="feature-label">DISTRIBUIÇÃO INTELIGENTE</span>
              <h3>Cada conversa vai para o vendedor certo.</h3>
            </div>
            <div class="routing-ui">
              <div class="routing-center"><span>IA</span><small>Analisando</small></div>
              <div class="route-person person-one"><i>RA</i><span>Rafael<small>Atacado</small></span></div>
              <div class="route-person person-two"><i>CM</i><span>Camila<small>Varejo</small></span></div>
              <div class="route-person person-three active"><i>LV</i><span>Lucas<small>Região Sul</small></span><b>Selecionado</b></div>
              <div class="route-path path-one"></div><div class="route-path path-two"></div><div class="route-path path-three"></div>
            </div>
          </article>

          <article class="bento-card tags-card" data-reveal>
            <div class="card-copy">
              <span class="feature-label">CONTEXTO ORGANIZADO</span>
              <h3>CRM atualizado sozinho.</h3>
              <p>Resumo, etapa e etiquetas sem preenchimento manual.</p>
            </div>
            <div class="tags-ui">
              <span class="tag-violet">alta intenção</span>
              <span class="tag-green">qualificado</span>
              <span class="tag-blue">atacado</span>
              <span class="tag-orange">retorno hoje</span>
              <span class="tag-neutral">150 peças</span>
              <span class="tag-pink">região sul</span>
            </div>
          </article>

          <article class="bento-card history-card" data-reveal>
            <div class="card-copy">
              <span class="feature-label">HISTÓRICO COMPLETO</span>
              <h3>Todo o contexto em uma tela.</h3>
            </div>
            <div class="history-ui">
              <div><i class="history-avatar">MC</i><p><strong>Mariana pediu condições para atacado</strong><small>WhatsApp · 10:24</small></p></div>
              <div><i class="history-icon">✦</i><p><strong>Contato qualificado pela IA</strong><small>Intenção alta · 10:25</small></p></div>
              <div><i class="history-icon">→</i><p><strong>Encaminhado para Rafael</strong><small>Distribuição automática · 10:25</small></p></div>
            </div>
          </article>

          <article class="bento-card metrics-card" data-reveal>
            <div class="card-copy">
              <span class="feature-label">VISÃO DA GESTÃO</span>
              <h3>Saiba o que está acontecendo.</h3>
            </div>
            <div class="metrics-ui">
              <div class="metric-main"><small>CONVERSAS QUALIFICADAS</small><strong>68<span>%</span></strong><p><i>↑ 12%</i> nos últimos 30 dias</p></div>
              <div class="metric-bars" aria-hidden="true">
                <i style="--h: 32%"></i><i style="--h: 48%"></i><i style="--h: 43%"></i><i style="--h: 60%"></i><i style="--h: 72%"></i><i style="--h: 65%"></i><i style="--h: 86%"></i><i style="--h: 76%"></i><i style="--h: 94%"></i>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="como-funciona" class="process-section">
      <div class="process-glow" aria-hidden="true"></div>
      <div class="shell">
        <div class="process-heading">
          <p class="section-kicker" data-reveal>DA ESTRATÉGIA À OPERAÇÃO</p>
          <h2 data-reveal>Pronto para funcionar. Gerenciado para evoluir.</h2>
          <p data-reveal>Daniel cuida da estrutura. Sua equipe cuida das oportunidades.</p>
        </div>
        <div class="process-grid">
          {steps.map(([number, title, text]) => (
            <article data-reveal>
              <span>{number}</span>
              <div class="step-visual"><i></i><b></b></div>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contato" class="final-cta">
      <div class="final-grid" aria-hidden="true"></div>
      <div class="final-orb" aria-hidden="true"></div>
      <div class="shell final-content">
        <div class="final-badge" data-reveal><i></i> Demonstração personalizada</div>
        <h2 data-reveal>Veja a IA atendendo. Veja o CRM se atualizando.</h2>
        <p data-reveal>Uma demonstração aplicada à realidade da sua empresa.</p>
        <a class="button button-primary final-button" href={demoUrl} target="_blank" rel="noreferrer" data-reveal>
          Agendar demonstração <span>↗</span>
        </a>
        <small data-reveal>Conversa direta com Daniel Junior.</small>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="brand">
        <span class="brand-mark">D</span>
        <span class="brand-copy"><strong>Daniel Junior</strong><small>Automação com IA</small></span>
      </div>
