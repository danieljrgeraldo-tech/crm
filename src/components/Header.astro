---
import { navItems, whatsappUrl } from "../data/site";
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="#top" class="rounded-full border border-white/10 bg-black/35 px-4 py-2 text-sm font-semibold text-white backdrop-blur-md">
      Daniel Junior
    </a>
    <nav class="hidden items-center gap-6 rounded-full border border-white/10 bg-black/30 px-5 py-3 text-sm text-white/70 backdrop-blur-md md:flex">
      {navItems.map((item) => <a href={item.href} class="transition hover:text-gold-300">{item.label}</a>)}
    </nav>
    <a href={whatsappUrl} target="_blank" rel="noreferrer" class="hidden rounded-full bg-white px-5 py-3 text-sm font-semibold text-black transition hover:bg-gold-100 md:inline-flex">
      Solicitar análise
    </a>
  </div>
</header>
