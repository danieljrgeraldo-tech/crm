---
const { title, index, tone = "dark" } = Astro.props;
const isLight = tone === "light";
---

<article class:list={[
  "premium-card section-reveal group rounded-lg p-6 shadow-card transition duration-300 hover:-translate-y-1",
  isLight ? "border border-stone-200 bg-white hover:border-gold-700/30" : "border border-white/10 bg-white/[.035] hover:border-gold-300/35 hover:bg-white/[.055]"
]}>
  <span class:list={["text-xs", isLight ? "text-gold-700/70" : "text-gold-300/70"]}>{String(index).padStart(2, "0")}</span>
  <h3 class:list={["mt-8 text-xl font-semibold leading-tight", isLight ? "text-stone-950" : "text-white"]}>{title}</h3>
  <div class="mt-5 h-px bg-gradient-to-r from-gold-300/50 to-transparent"></div>
</article>
