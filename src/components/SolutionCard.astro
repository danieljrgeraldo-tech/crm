---
const { title, index } = Astro.props;
---

<article class="section-reveal group rounded-lg border border-white/10 bg-white/[.035] p-5 shadow-card transition duration-300 hover:-translate-y-1 hover:border-gold-300/35 hover:bg-white/[.055]">
  <span class="text-xs text-gold-300/70">{String(index).padStart(2, "0")}</span>
  <h3 class="mt-8 text-xl font-semibold leading-tight text-white">{title}</h3>
  <div class="mt-5 h-px bg-gradient-to-r from-gold-300/50 to-transparent"></div>
</article>
