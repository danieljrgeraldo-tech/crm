---
---

<section id="crm" class="crm-section">
  <div class="shell">
    <div class="section-header">
      <span class="section-tag">ESTRUTURAÇÃO & FUNIL DE OPERAÇÕES</span>
      <h2 class="section-title">
        Você acompanha cada proposta <br />
        <span class="highlight">em tempo real no CRM.</span>
      </h2>
      <p class="section-desc">
        Saiba exatamente quem fez simulação, quem está em qualificação, quem já recebeu o PDF, quem agendou reunião no Meet e quem teve a proposta aprovada. Tudo sincronizado com o WhatsApp.
      </p>
    </div>

    <!-- Authentic Kanban Showcase Board (Subtle Pastel Kanban Stage Colors) -->
    <div class="kanban-showcase-board">
      <div class="board-top-bar">
        <div class="bar-left">
          <div class="window-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
          <strong>Visão da Mesa de Crédito · Pipeline de Negócios</strong>
        </div>
        <div class="bar-right">
          <span class="live-sync-badge">✓ Sincronizado com WhatsApp</span>
        </div>
      </div>

      <!-- 6 Kanban Columns Grid (Subtle Pastel Kanban Stage Columns) -->
      <div class="kanban-columns-grid">
        
        <!-- Col 1: Simulação Recebida (Subtle Blue Tint) -->
        <div class="kanban-col blue-col">
          <header class="col-head">
            <span class="col-indicator"></span>
            <strong>Simulação Recebida</strong>
            <span class="col-count">3</span>
          </header>
          <div class="col-cards">
            <div class="kanban-deal-card">
              <div class="card-user-row">
                <img src="/images/people/fernanda.jpg" alt="Fernanda Costa" class="deal-avatar" />
                <div>
                  <strong>Fernanda Costa</strong>
                  <small>há 2 min</small>
                </div>
              </div>
              <p class="deal-snippet">Carta de R$ 300k. Simulação preenchida no site.</p>
              <span class="deal-tag blue-tag">Novo Lead</span>
            </div>

            <div class="kanban-deal-card">
              <div class="card-user-row">
                <img src="/images/people/renato.jpg" alt="Renato Melo" class="deal-avatar" />
                <div>
                  <strong>Renato Melo</strong>
                  <small>há 8 min</small>
                </div>
              </div>
              <p class="deal-snippet">Crédito com garantia de imóvel. R$ 500k pretendido.</p>
              <span class="deal-tag blue-tag">Simulação Site</span>
            </div>
          </div>
        </div>

        <!-- Col 2: Em Qualificação (Subtle Cyan/Teal Tint) -->
        <div class="kanban-col cyan-col">
          <header class="col-head">
            <span class="col-indicator"></span>
            <strong>Em Qualificação</strong>
            <span class="col-count">4</span>
          </header>
          <div class="col-cards">
            <div class="kanban-deal-card">
              <div class="card-user-row">
                <img src="/images/people/amanda.jpg" alt="Amanda Silva" class="deal-avatar" />
                <div>
                  <strong>Amanda Silva</strong>
                  <small>há 5 min</small>
                </div>
              </div>
              <p class="deal-snippet">Tirando dúvidas sobre meia-parcela vs lance embutido.</p>
              <span class="deal-tag cyan-tag">Em atendimento</span>
            </div>
          </div>
        </div>

        <!-- Col 3: Proposta & PDF (Subtle Purple Tint) -->
        <div class="kanban-col purple-col">
          <header class="col-head">
            <span class="col-indicator"></span>
            <strong>Proposta & PDF</strong>
            <span class="col-count">5</span>
          </header>
          <div class="col-cards">
            <div class="kanban-deal-card">
              <div class="card-user-row">
                <img src="/images/people/lucas.jpg" alt="João Martins" class="deal-avatar" />
                <div>
                  <strong>João Martins</strong>
                  <small>há 12 min</small>
                </div>
              </div>
              <p class="deal-snippet">Carta de R$ 250k. PDF com meia-parcela R$ 815 enviado.</p>
              <span class="deal-tag purple-tag">Proposta Entregue</span>
            </div>
          </div>
        </div>

        <!-- Col 4: Reunião Agendada (Subtle Amber Tint) -->
        <div class="kanban-col amber-col">
          <header class="col-head">
            <span class="col-indicator"></span>
            <strong>Reunião no Meet</strong>
            <span class="col-count">2</span>
          </header>
          <div class="col-cards">
            <div class="kanban-deal-card featured-card">
              <div class="card-user-row">
                <img src="/images/people/mariana.jpg" alt="Marcelo Bittencourt" class="deal-avatar" />
                <div>
                  <strong>Marcelo Bittencourt</strong>
                  <small>Quinta · 15h00</small>
                </div>
              </div>
              <p class="deal-snippet">Cota R$ 450k. Alinhamento de lance embutido de 30% no Meet.</p>
              <span class="deal-tag amber-tag">Anderson Alves</span>
            </div>
          </div>
        </div>

        <!-- Col 5: Em Análise (Subtle Orange Tint) -->
        <div class="kanban-col coral-col">
          <header class="col-head">
            <span class="col-indicator"></span>
            <strong>Em Análise / Comitê</strong>
            <span class="col-count">3</span>
          </header>
          <div class="col-cards">
            <div class="kanban-deal-card">
              <div class="card-user-row">
                <img src="/images/people/fernanda.jpg" alt="Carla Reis" class="deal-avatar" />
                <div>
                  <strong>Carla Reis</strong>
                  <small>09:00</small>
                </div>
              </div>
              <p class="deal-snippet">Home Equity R$ 350k. Matrícula enviada para análise jurídica.</p>
              <span class="deal-tag coral-tag">Em Análise</span>
            </div>
          </div>
        </div>

        <!-- Col 6: Faturado / Contemplado (Subtle Green Tint) -->
        <div class="kanban-col green-col">
          <header class="col-head">
            <span class="col-indicator"></span>
            <strong>Faturado / Contemplado</strong>
            <span class="col-count">8</span>
          </header>
          <div class="col-cards">
            <div class="kanban-deal-card success-card">
              <div class="card-user-row">
                <img src="/images/people/renato.jpg" alt="Roberto Dias" class="deal-avatar" />
                <div>
                  <strong>Roberto Dias</strong>
                  <small>Ontem</small>
                </div>
              </div>
              <p class="deal-snippet">Cota de R$ 600k contemplada. Faturamento liberado.</p>
              <span class="deal-tag green-tag">Contrato Assinado ✓</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .crm-section {
    padding: 90px 0;
    background: #f8fafc;
    color: #0f172a;
    border-top: 1px solid #e2e8f0;
  }

  .shell {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px;
  }

  .section-tag {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    background: rgba(0, 168, 132, 0.15);
    color: #00a884;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #0f172a;
  }

  .section-title .highlight {
    color: #4cd9a4;
  }

  .section-desc {
    margin-top: 16px;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #475569;
  }

  /* Authentic Kanban Board */
  .kanban-showcase-board {
    background: #ffffff;
    border: 1px solid #dbe4ea;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.1);
  }

  /* Responsive Top Bar */
  .board-top-bar {
    min-height: 44px;
    padding: 10px 16px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-sizing: border-box;
  }

  .bar-left {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #0f172a;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .window-dots {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .window-dots .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .window-dots .dot.red { background: #ef4444; }
  .window-dots .dot.yellow { background: #f59e0b; }
  .window-dots .dot.green { background: #10b981; }

  .bar-left strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .live-sync-badge {
    font-size: 11px;
    font-weight: 700;
    color: #00a884;
    white-space: nowrap;
  }

  /* Kanban Columns Grid Background */
  .kanban-columns-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    padding: 16px;
    overflow-x: auto;
    background: #f1f5f9;
  }

  /* Kanban Stage Columns (Subtle Pastel Tints) */
  .kanban-col {
    border-radius: 12px;
    padding: 12px 10px;
    min-width: 170px;
    border: 1px solid transparent;
  }

  .blue-col { background: #e8f2ff; border-color: #bfd8ff; }
  .cyan-col { background: #e3f9fb; border-color: #b8e9ee; }
  .purple-col { background: #f5ecff; border-color: #dfc9fa; }
  .amber-col { background: #fff5d9; border-color: #f6dfa1; }
  .coral-col { background: #ffeadb; border-color: #f8ccb0; }
  .green-col { background: #e5f8eb; border-color: #bde5ca; }

  .col-head {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 12px;
  }

  .col-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .blue-col .col-indicator { background: #2563eb; }
  .cyan-col .col-indicator { background: #0891b2; }
  .purple-col .col-indicator { background: #9333ea; }
  .amber-col .col-indicator { background: #d97706; }
  .coral-col .col-indicator { background: #ea580c; }
  .green-col .col-indicator { background: #059669; }

  .col-count {
    margin-left: auto;
    font-size: 10px;
    background: rgba(15, 23, 42, 0.08);
    color: #475569;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 10px;
  }

  .col-cards {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Sharp White Cards Inside Subtle Stage Containers */
  .kanban-deal-card {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 10px;
    padding: 10px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .kanban-deal-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(0,0,0,0.08);
    border-color: #00a884;
  }

  .kanban-deal-card.featured-card {
    border-color: #a855f7;
    background: #ffffff;
    box-shadow: 0 4px 12px rgba(168, 85, 247, 0.15);
  }

  .kanban-deal-card.success-card {
    border-color: #10b981;
    background: #ffffff;
  }

  .card-user-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .deal-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }

  .card-user-row strong { display: block; font-size: 11.5px; color: #0f172a; }
  .card-user-row small { font-size: 9px; color: #64748b; }

  .deal-snippet {
    font-size: 10.5px;
    line-height: 1.4;
    color: #334155;
    margin-bottom: 8px;
  }

  .deal-tag {
    display: inline-block;
    font-size: 8.5px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .blue-tag { background: rgba(37, 99, 235, 0.12); color: #1d4ed8; }
  .cyan-tag { background: rgba(8, 145, 178, 0.12); color: #0e7490; }
  .purple-tag { background: rgba(147, 51, 234, 0.12); color: #7e22ce; }
  .amber-tag { background: rgba(217, 119, 6, 0.12); color: #b45309; }
  .coral-tag { background: rgba(234, 88, 12, 0.12); color: #c2410c; }
  .green-tag { background: rgba(5, 150, 105, 0.12); color: #047857; }

  @media (max-width: 640px) {
    .board-top-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .bar-left strong {
      font-size: 11px;
    }
    .live-sync-badge {
      font-size: 10px;
    }
  }
</style>
