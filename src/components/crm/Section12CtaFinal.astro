---
const whatsappUrl = "https://wa.me/5548998493150?text=Ol%C3%A1%2C%20Daniel.%20Quero%20uma%20demonstra%C3%A7%C3%A3o%20de%20como%20a%20IA%20pode%20funcionar%20no%20meu%20atendimento.";
---

<section id="contato" class="final-cta-section">
  <div class="shell">
    <div class="cta-card-box">
      <span class="cta-tag">PRÓXIMO PASSO</span>
      <h2 class="cta-title">
        Quer ver isso funcionando <br />
        <span class="highlight">na sua empresa?</span>
      </h2>
      <p class="cta-desc">
        Me mostra como seu atendimento funciona hoje e eu te mostro onde a IA pode entrar.
      </p>
      <div class="cta-button-wrap">
        <a href={whatsappUrl} target="_blank" rel="noreferrer" class="btn-cta-large">
          Quero uma demonstração <span class="arrow">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    padding: 90px 0 110px;
    background: #0d121c;
    color: #fff;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .shell {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .cta-card-box {
    text-align: center;
    background: linear-gradient(135deg, #151f2b 0%, #192736 100%);
    border: 1px solid rgba(0, 168, 132, 0.3);
    border-radius: 24px;
    padding: 50px 24px;
    max-width: 800px;
    margin: 0 auto;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4), 0 0 30px rgba(0, 168, 132, 0.1);
  }

  .cta-tag {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    background: rgba(0, 168, 132, 0.15);
    color: #00a884;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }

  .cta-title {
    font-size: clamp(2.1rem, 3.8vw, 3rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .cta-title .highlight {
    color: #4cd9a4;
  }

  .cta-desc {
    margin-top: 14px;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #9ba4b5;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-button-wrap {
    margin-top: 30px;
  }

  .btn-cta-large {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    border-radius: 12px;
    background: linear-gradient(135deg, #00a884 0%, #008f70 100%);
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(0, 168, 132, 0.35);
    transition: transform 0.25s, box-shadow 0.25s;
    animation: cta-breathe 3.6s ease-in-out infinite;
  }

  .btn-cta-large::before {
    content: "";
    position: absolute;
    inset: -60% auto -60% -35%;
    width: 28%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.7), transparent);
    transform: rotate(18deg);
    animation: cta-shine 3.6s ease-in-out infinite;
  }

  .btn-cta-large .arrow { animation: cta-arrow 1.8s ease-in-out infinite; }

  .btn-cta-large:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 35px rgba(0, 168, 132, 0.45);
  }

  @keyframes cta-breathe {
    0%, 100% { box-shadow: 0 10px 30px rgba(0,168,132,.32), 0 0 0 0 rgba(76,217,164,.2); }
    50% { box-shadow: 0 16px 38px rgba(0,168,132,.48), 0 0 0 9px rgba(76,217,164,0); }
  }

  @keyframes cta-shine {
    0%, 28% { left: -35%; opacity: 0; }
    42% { opacity: 1; }
    58%, 100% { left: 118%; opacity: 0; }
  }

  @keyframes cta-arrow {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(3px, -3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-cta-large, .btn-cta-large::before, .btn-cta-large .arrow { animation: none; }
  }
</style>
