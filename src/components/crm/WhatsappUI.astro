---
interface Props {
  contactName?: string;
  contactStatus?: string;
  avatarUrl?: string;
  class?: string;
  id?: string;
}

const {
  contactName = "Mariana Costa",
  contactStatus = "online agora",
  avatarUrl = "/images/people/mariana.jpg",
  class: className = "",
  id = "",
} = Astro.props;
---

<div class={`wa-window ${className}`} id={id}>
  <!-- WhatsApp Header -->
  <header class="wa-header">
    <div class="wa-header-left">
      <div class="wa-avatar-wrap">
        <img src={avatarUrl} alt={contactName} class="wa-avatar" />
        <span class="wa-online-dot"></span>
      </div>
      <div class="wa-contact-info">
        <strong class="wa-contact-name">{contactName}</strong>
        <span class="wa-contact-status">{contactStatus}</span>
      </div>
    </div>
    <div class="wa-header-right" aria-hidden="true">
      <svg class="wa-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92z"/></svg>
      <svg class="wa-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M12 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm0 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm0 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>
    </div>
  </header>

  <!-- WhatsApp Chat Body -->
  <div class="wa-chat-body">
    <div class="wa-wallpaper"></div>
    <div class="wa-messages">
      <slot />
    </div>
  </div>

  <!-- WhatsApp Input Bar Footer -->
  <footer class="wa-footer" aria-hidden="true">
    <div class="wa-input-pill">
      <svg class="wa-icon-subtle" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm-3-8a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm6 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm-3 5a4 4 0 0 0 3.46-2H8.54A4 4 0 0 0 12 17z"/></svg>
      <span class="wa-placeholder">Mensagem</span>
      <svg class="wa-icon-subtle" viewBox="0 0 24 24"><path fill="currentColor" d="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5a2.5 2.5 0 0 1 5 0v10.5c0 .83-.67 1.5-1.5 1.5s-1.5-.67-1.5-1.5V6H9v9.5a3 3 0 0 0 6 0V5a4 4 0 0 0-8 0v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z"/></svg>
    </div>
    <button class="wa-mic-btn" type="button" aria-label="Enviar áudio">
      <svg class="wa-mic-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11z"/></svg>
    </button>
  </footer>
</div>

<style>
  .wa-window {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    border-radius: 18px;
    overflow: hidden;
    background: #efeae2;
    border: 1px solid rgba(17, 27, 33, 0.12);
    box-shadow: 0 24px 60px rgba(17, 27, 33, 0.22), 0 0 0 1px rgba(0, 128, 105, 0.08);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .wa-header {
    height: 56px;
    padding: 0 14px;
    background: #008069;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(17, 27, 33, 0.08);
    z-index: 5;
  }

  .wa-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .wa-avatar-wrap {
    position: relative;
    width: 38px;
    height: 38px;
  }

  .wa-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .wa-online-dot {
    position: absolute;
    bottom: 1px;
    right: 1px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #d9fdd3;
    border: 2px solid #008069;
  }

  .wa-contact-info {
    display: flex;
    flex-direction: column;
  }

  .wa-contact-name {
    color: #ffffff;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.2;
  }

  .wa-contact-status {
    color: rgba(255, 255, 255, 0.86);
    font-size: 11.5px;
    line-height: 1.2;
    margin-top: 1px;
  }

  .wa-header-right {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #ffffff;
  }

  .wa-icon {
    width: 18px;
    height: 18px;
  }

  .wa-chat-body {
    position: relative;
    height: 410px;
    min-height: 410px;
    background: #efeae2;
    padding: 14px 12px;
    overflow: hidden;
    text-align: left;
  }

  .wa-wallpaper {
    position: absolute;
    inset: 0;
    opacity: 0.22;
    background-image:
      radial-gradient(circle at 12px 12px, rgba(84, 101, 111, 0.22) 1px, transparent 1.5px),
      radial-gradient(circle at 4px 4px, rgba(84, 101, 111, 0.12) 1px, transparent 1.5px);
    background-size: 24px 24px, 24px 24px;
    pointer-events: none;
  }

  .wa-messages {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    justify-content: flex-end;
  }

  :global(.wa-window [data-chat-playback]) {
    min-height: 100%;
    justify-content: flex-end;
  }

  .wa-footer {
    height: 54px;
    padding: 6px 10px;
    background: #f0f2f5;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 5;
  }

  .wa-input-pill {
    flex: 1;
    height: 38px;
    border-radius: 8px;
    background: #ffffff;
    display: flex;
    align-items: center;
    padding: 0 10px;
    gap: 8px;
    color: #667781;
  }

  .wa-placeholder {
    flex: 1;
    font-size: 13.5px;
    color: #667781;
  }

  .wa-icon-subtle {
    width: 18px;
    height: 18px;
  }

  .wa-mic-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #00a884;
    border: none;
    display: grid;
    place-items: center;
    color: #ffffff;
  }

  .wa-mic-icon {
    width: 18px;
    height: 18px;
  }

  /* Shared Bubble Styles for slots */
  :global(.wa-bubble) {
    position: relative;
    max-width: 82%;
    padding: 8px 10px 6px 10px;
    border-radius: 8px;
    font-size: 13.5px;
    line-height: 1.4;
    word-break: break-word;
    box-shadow: 0 1px 0.5px rgba(11,20,26,0.13);
    text-align: left;
  }

  :global(.wa-bubble.incoming) {
    align-self: flex-start;
    background: #ffffff;
    color: #111b21;
    border-top-left-radius: 0;
  }

  :global(.wa-bubble.outgoing) {
    align-self: flex-end;
    background: #d9fdd3;
    color: #111b21;
    border-top-right-radius: 0;
  }

  :global(.wa-meta) {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    float: right;
    margin-left: 10px;
    margin-top: 4px;
    font-size: 10.5px;
    color: #667781;
  }

  :global(.wa-bubble.outgoing .wa-meta) {
    color: #667781;
  }

  :global(.wa-checks) {
    color: #53bdeb;
    font-weight: bold;
    font-size: 11px;
  }

  :global(.wa-window .wa-time-divider),
  :global(.wa-window .wa-gap-divider) {
    text-align: center;
  }

  :global(.wa-window .wa-time-divider span),
  :global(.wa-window .wa-gap-divider span) {
    display: inline-block;
    padding: 4px 9px;
    border: 0;
    border-radius: 7px;
    background: #ffffff;
    color: #54656f;
    box-shadow: 0 1px 1px rgba(11, 20, 26, 0.08);
    font-size: 10px;
  }

  :global(.wa-window .wa-pdf-attachment-box) {
    align-self: flex-end;
    background: #d9fdd3;
    color: #111b21;
    border-color: rgba(17, 27, 33, 0.08);
  }
</style>
