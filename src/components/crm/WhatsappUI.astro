---
interface Props {
  contactName?: string;
  contactStatus?: string;
  avatarUrl?: string;
  class?: string;
  id?: string;
}

const {
  contactName = "Mariana Costa",
  contactStatus = "online agora",
  avatarUrl = "/images/people/mariana.jpg",
  class: className = "",
  id = "",
} = Astro.props;
---

<div class={`wa-window ${className}`} id={id}>
  <!-- WhatsApp Header -->
  <header class="wa-header">
    <div class="wa-header-left">
      <div class="wa-avatar-wrap">
        <img src={avatarUrl} alt={contactName} class="wa-avatar" />
        <span class="wa-online-dot"></span>
      </div>
      <div class="wa-contact-info">
        <strong class="wa-contact-name">{contactName}</strong>
        <span class="wa-contact-status">{contactStatus}</span>
      </div>
    </div>
    <div class="wa-header-right" aria-hidden="true">
      <svg class="wa-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M15.9 14.3c-.4-.2-2.3-1.1-2.7-1.3-.4-.2-.7-.2-.9.2-.2.4-.9 1.3-1.1 1.5-.2.2-.4.3-.8.1-2.4-1.2-4-2.1-5.6-4.9-.4-.7.4-.7 1.1-2.1.1-.2 0-.4-.1-.6s-.9-2.2-1.2-3c-.3-.8-.6-.7-.9-.7h-.7c-.3 0-.9.1-1.4.6C5.2 4.7 4 5.9 4 8.3c0 2.4 1.7 4.7 2 5.1.3.4 3.4 5.2 8.3 7.3 3.3 1.4 4.6 1.3 5.4 1.1.9-.2 2.7-1.1 3.1-2.2.4-1.1.4-2 .3-2.2-.2-.2-.5-.3-.9-.5z"/></svg>
      <svg class="wa-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M12 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm0 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm0 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>
    </div>
  </header>

  <!-- WhatsApp Chat Body -->
  <div class="wa-chat-body">
    <div class="wa-wallpaper"></div>
    <div class="wa-messages">
      <slot />
    </div>
  </div>

  <!-- WhatsApp Input Bar Footer -->
  <footer class="wa-footer" aria-hidden="true">
    <div class="wa-input-pill">
      <svg class="wa-icon-subtle" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm-3-8a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm6 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm-3 5a4 4 0 0 0 3.46-2H8.54A4 4 0 0 0 12 17z"/></svg>
      <span class="wa-placeholder">Mensagem</span>
      <svg class="wa-icon-subtle" viewBox="0 0 24 24"><path fill="currentColor" d="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5a2.5 2.5 0 0 1 5 0v10.5c0 .83-.67 1.5-1.5 1.5s-1.5-.67-1.5-1.5V6H9v9.5a3 3 0 0 0 6 0V5a4 4 0 0 0-8 0v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z"/></svg>
    </div>
    <button class="wa-mic-btn" type="button" aria-label="Enviar áudio">
      <svg class="wa-mic-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11z"/></svg>
    </button>
  </footer>
</div>

<style>
  .wa-window {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    border-radius: 18px;
    overflow: hidden;
    background: #0b141a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(0, 168, 132, 0.2);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .wa-header {
    height: 56px;
    padding: 0 14px;
    background: #202c33;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    z-index: 5;
  }

  .wa-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .wa-avatar-wrap {
    position: relative;
    width: 38px;
    height: 38px;
  }

  .wa-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .wa-online-dot {
    position: absolute;
    bottom: 1px;
    right: 1px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #00a884;
    border: 2px solid #202c33;
  }

  .wa-contact-info {
    display: flex;
    flex-direction: column;
  }

  .wa-contact-name {
    color: #e9edef;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.2;
  }

  .wa-contact-status {
    color: #00a884;
    font-size: 11.5px;
    line-height: 1.2;
    margin-top: 1px;
  }

  .wa-header-right {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #aebac1;
  }

  .wa-icon {
    width: 18px;
    height: 18px;
  }

  .wa-chat-body {
    position: relative;
    min-height: 350px;
    background: #0b141a;
    padding: 14px 12px;
    overflow: hidden;
  }

  .wa-wallpaper {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    background-image: radial-gradient(#00a884 1px, transparent 1px);
    background-size: 16px 16px;
    pointer-events: none;
  }

  .wa-messages {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .wa-footer {
    height: 54px;
    padding: 6px 10px;
    background: #202c33;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 5;
  }

  .wa-input-pill {
    flex: 1;
    height: 38px;
    border-radius: 8px;
    background: #2a3942;
    display: flex;
    align-items: center;
    padding: 0 10px;
    gap: 8px;
    color: #8696a0;
  }

  .wa-placeholder {
    flex: 1;
    font-size: 13.5px;
    color: #8696a0;
  }

  .wa-icon-subtle {
    width: 18px;
    height: 18px;
  }

  .wa-mic-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #00a884;
    border: none;
    display: grid;
    place-items: center;
    color: #111b21;
  }

  .wa-mic-icon {
    width: 18px;
    height: 18px;
  }

  /* Shared Bubble Styles for slots */
  :global(.wa-bubble) {
    position: relative;
    max-width: 82%;
    padding: 8px 10px 6px 10px;
    border-radius: 8px;
    font-size: 13.5px;
    line-height: 1.4;
    word-break: break-word;
    box-shadow: 0 1px 0.5px rgba(11,20,26,0.13);
  }

  :global(.wa-bubble.incoming) {
    align-self: flex-start;
    background: #202c33;
    color: #e9edef;
    border-top-left-radius: 0;
  }

  :global(.wa-bubble.outgoing) {
    align-self: flex-end;
    background: #005c4b;
    color: #e9edef;
    border-top-right-radius: 0;
  }

  :global(.wa-meta) {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    float: right;
    margin-left: 10px;
    margin-top: 4px;
    font-size: 10.5px;
    color: #8696a0;
  }

  :global(.wa-bubble.outgoing .wa-meta) {
    color: rgba(233, 237, 239, 0.65);
  }

  :global(.wa-checks) {
    color: #53bdeb;
    font-weight: bold;
    font-size: 11px;
  }
</style>
