<footer class="crm-footer">
  <div class="shell footer-inner">
    <div class="footer-brand">
      <span class="brand-icon">✦</span>
      <strong>Daniel Junior</strong>
      <p>Operação de Atendimento Comercial com Inteligência Artificial</p>
    </div>
    <div class="footer-copy">
      <small>© 2026 Daniel Junior · Todos os direitos reservados</small>
    </div>
  </div>
</footer>

<style>
  .crm-footer {
    padding: 40px 0;
    background: #06080d;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    color: #8696a0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-icon {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: #00a884;
    color: #111b21;
    display: grid;
    place-items: center;
    font-size: 12px;
  }

  .footer-brand strong {
    color: #e9edef;
    font-size: 14px;
  }

  .footer-brand p {
    font-size: 12px;
    color: #64748b;
    margin: 0 0 0 12px;
    padding-left: 12px;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-copy small {
    font-size: 12px;
  }
</style>
