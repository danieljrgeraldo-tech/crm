        <img src="/images/people/fernanda.jpg" alt="" width="64" height="64" />
        <div class="lead-message">
          <small>NOVO LEAD · ÁUDIO RECEBIDO</small>
          <div class="audio"><button type="button" aria-label="Áudio ilustrativo, sem reprodução">▶</button><span><i></i></span><time>0:12</time></div>
