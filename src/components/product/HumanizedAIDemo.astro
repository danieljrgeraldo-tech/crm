  .qualified-card { position:absolute;left:50%;top:50%;width:min(480px,calc(100% - 36px));padding:1rem;border:1px solid rgba(133,111,255,.5);border-top:4px solid #7758e8;border-radius:17px;color:#222938;background:#f4f6fa;box-shadow:0 28px 60px rgba(0,0,0,.38);opacity:0;overflow:hidden;transform:translate(-50%,-44%) scale(.88);animation:card-conversion 20s ease-in-out infinite; }.qualified-card::before{content:"";position:absolute;inset:-70% -30%;background:linear-gradient(110deg,transparent 40%,rgba(255,255,255,.9),transparent 60%);transform:translateX(-75%) rotate(15deg);animation:completed-shine 20s ease-in-out infinite}.qualified-card::after{content:"✓";position:absolute;right:1rem;top:1rem;width:34px;height:34px;display:grid;place-items:center;border-radius:50%;color:#fff;background:#2fac79;box-shadow:0 0 0 7px rgba(47,172,121,.12);opacity:0;animation:completed-check 20s cubic-bezier(.2,.9,.25,1.2) infinite}.kanban-label { display:flex;align-items:center;gap:.45rem;color:#7358ed;font-size:.49rem;font-weight:800;letter-spacing:.08em; }.kanban-label i { width:7px;height:7px;border-radius:50%;background:#7358ed; }.qualified-head { display:grid;grid-template-columns:46px 1fr auto;gap:.7rem;align-items:center;margin-top:1rem;padding-bottom:1rem;border-bottom:1px solid #dfe3ea; }.qualified-head img { width:46px;height:46px;border:3px solid white;border-radius:50%;object-fit:cover;box-shadow:0 4px 12px rgba(28,32,42,.15); }.qualified-head span { display:flex;flex-direction:column; }.qualified-head strong { font-size:.72rem; }.qualified-head small { margin-top:.2rem;color:#747c8a;font-size:.53rem; }.qualified-head b { color:#8b929f;font-size:.46rem; }.qualified-data { display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-top:.8rem; }.qualified-data span { display:flex;flex-direction:column;padding:.7rem;border:1px solid #dfe3ea;border-radius:10px;background:white; }.qualified-data small { color:#969ca8;font-size:.45rem; }.qualified-data strong { margin-top:.2rem;font-size:.58rem; }.qualified-card footer { display:flex;align-items:center;gap:.7rem;margin-top:.8rem;padding:.8rem;border-radius:11px;color:#27684f;background:#e2f5ec; }.qualified-card footer > i { width:30px;height:30px;display:grid;place-items:center;border-radius:9px;color:#1b7753;background:#ccebdd;font-style:normal; }.qualified-card footer span { display:flex;flex-direction:column; }.qualified-card footer small { color:#4d8d72;font-size:.42rem;font-weight:800; }.qualified-card footer strong { margin-top:.15rem;font-size:.59rem; }
