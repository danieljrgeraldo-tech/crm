  @keyframes signal-two { 0%,27%,96%,100%{opacity:0;transform:translateY(8px)} 32%,75%{opacity:1;transform:none} 84%{opacity:0} }
  @keyframes typing-one { 0%,38%,49%,100%{opacity:0} 40%,47%{opacity:1} }.ai-message-one{animation-name:message-one}@keyframes message-one { 0%,47%,96%,100%{opacity:0;transform:translateY(8px)} 51%,78%{opacity:1;transform:none} 86%{opacity:0} }
