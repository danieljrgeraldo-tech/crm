  .human-demo > header div,.human-demo > header p { display:flex; align-items:center; gap:.65rem; }.human-demo > header div > span { width:32px;height:32px;display:grid;place-items:center;border-radius:9px;background:linear-gradient(145deg,#7859ff,#4c89ff);font-size:.55rem;font-weight:800; }.human-demo > header strong { font-size:.73rem; }.human-demo > header p { margin:0;color:#929aab;font-size:.58rem; }.human-demo > header p i { width:7px;height:7px;border-radius:50%;background:#43d39e;box-shadow:0 0 0 5px rgba(67,211,158,.1); }
