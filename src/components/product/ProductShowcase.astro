<script>
  const showcases = document.querySelectorAll<HTMLElement>("[data-showcase]");

  showcases.forEach((showcase) => {
    const tabs = Array.from(showcase.querySelectorAll<HTMLButtonElement>("[data-tab-index]"));
    const panels = Array.from(showcase.querySelectorAll<HTMLElement>("[data-panel-index]"));
    const track = showcase.querySelector<HTMLElement>("[data-showcase-track]");
    const kanbanViewport = showcase.querySelector<HTMLElement>("[data-kanban-viewport]");
    const kanbanColumns = Array.from(showcase.querySelectorAll<HTMLElement>(".kanban-column"));
    const kanbanDots = Array.from(showcase.querySelectorAll<HTMLButtonElement>("[data-kanban-dot]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let kanbanIndex = 0;
    let kanbanTimer: number | undefined;

    const showKanbanStep = (index: number, smooth = true) => {
      if (!kanbanViewport || !kanbanColumns.length) return;
      kanbanIndex = (index + kanbanColumns.length) % kanbanColumns.length;
      const column = kanbanColumns[kanbanIndex];
      const firstColumnOffset = kanbanColumns[0]?.offsetLeft ?? 0;
      kanbanViewport.scrollTo({ left: Math.max(0, column.offsetLeft - firstColumnOffset), behavior: smooth ? "smooth" : "auto" });
      kanbanColumns.forEach((item, itemIndex) => item.classList.toggle("is-active", itemIndex === kanbanIndex));
      kanbanDots.forEach((dot, dotIndex) => dot.setAttribute("aria-current", dotIndex === kanbanIndex ? "step" : "false"));
    };

    const stopKanban = () => {
      if (kanbanTimer) window.clearInterval(kanbanTimer);
      kanbanTimer = undefined;
    };

    const startKanban = () => {
      stopKanban();
      showKanbanStep(0, false);
      if (reduceMotion.matches || !window.matchMedia("(max-width: 650px)").matches) return;
      kanbanTimer = window.setInterval(() => showKanbanStep(kanbanIndex + 1), 3200);
    };

    const activate = (tab: HTMLButtonElement) => {
      const index = Number(tab.dataset.tabIndex ?? 0);
      tabs.forEach((item, itemIndex) => {
        const active = itemIndex === index;
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel, panelIndex) => panel.setAttribute("aria-hidden", String(panelIndex !== index)));
      track?.style.setProperty("--showcase-index", String(index));
      if (index === 1) startKanban();
      else stopKanban();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;
        const nextTab = tabs[nextIndex];
        activate(nextTab);
        nextTab.focus();
      });
    });

    kanbanDots.forEach((dot, index) => dot.addEventListener("click", () => {
      showKanbanStep(index);
      if (!reduceMotion.matches && window.matchMedia("(max-width: 650px)").matches) {
        stopKanban();
        kanbanTimer = window.setInterval(() => showKanbanStep(kanbanIndex + 1), 3200);
      }
    }));
    showKanbanStep(0, false);
  });
</script>

