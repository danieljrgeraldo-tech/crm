---
import { site } from "../../data/site-content.js";
import SectionLabel from "./SectionLabel.astro";
import MotionText from "./MotionText.astro";

const content = site.productComesLater;
---

<section
  id="visao"
  class="relative bg-paper-dark py-20 lg:py-28"
  aria-labelledby="product-title"
>
  <div class="pointer-events-none absolute inset-0 opacity-30" aria-hidden="true">
    <div class="technical-line top-0 left-[6%] h-full w-px"></div>
    <div class="technical-line top-0 right-[6%] h-full w-px hidden lg:block"></div>
  </div>

  <div class="content-container relative z-10">
    <SectionLabel text={content.eyebrow} />

    <h2
      id="product-title"
      class="mt-6 max-w-3xl font-display text-4xl font-light leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-6xl"
    >
      <MotionText as="span" class="block" type="reveal-line">
        {content.title}
      </MotionText>
    </h2>

    <MotionText as="p" class="mt-6 max-w-2xl text-lg leading-relaxed text-graphite lg:mt-8 lg:text-xl" type="reveal">
      {content.text}
    </MotionText>

    <!-- Mapa visual de decisão -->
    <div class="decision-map relative mt-14 lg:mt-20">
      <!-- Central node -->
      <div class="relative flex flex-col items-center justify-center gap-10 lg:flex-row lg:gap-6">
        <div class="factor-ring grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-3">
          {content.factors.map((factor, i) => (
            <div
              class="factor-node group relative border border-line bg-paper-light px-4 py-5 transition-colors duration-300 hover:bg-white sm:px-5 sm:py-6"
              data-motion="reveal"
            >
              <span class="font-sans text-[10px] font-medium uppercase tracking-widest text-muted">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="mt-2 block font-display text-2xl font-light text-ink sm:text-3xl">
                {factor.label}
              </span>
              <span class="mt-2 block font-sans text-sm leading-relaxed text-muted">
                {factor.description}
              </span>
            </div>
          ))}
        </div>

        <!-- Connector to decision -->
        <div class="hidden lg:flex lg:flex-col lg:items-center lg:gap-2" aria-hidden="true">
          <div class="h-px w-20 bg-line"></div>
          <span class="font-sans text-[10px] uppercase tracking-widest text-muted">convergem para</span>
          <div class="h-px w-20 bg-line"></div>
        </div>

        <div
          class="decision-center flex min-h-[10rem] w-full max-w-xs flex-col justify-center border border-ink bg-ink px-6 py-8 text-center lg:min-h-[14rem]"
          data-motion="reveal"
        >
          <span class="font-sans text-[10px] font-medium uppercase tracking-widest text-copper-light">
            Decisão estruturada
          </span>
          <span class="mt-3 block font-display text-2xl font-light leading-snug text-white sm:text-3xl">
            Qual caminho faz sentido?
          </span>
        </div>
      </div>

      <!-- Linhas decorativas -->
      <div class="pointer-events-none absolute inset-0 -z-10 hidden lg:block" aria-hidden="true">
        <div class="technical-line top-1/2 left-[6%] right-[6%] h-px -translate-y-1/2"></div>
      </div>
    </div>
  </div>
</section>
