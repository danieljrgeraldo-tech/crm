---
import { site } from "../../data/site-content.js";
import SectionLabel from "./SectionLabel.astro";
import MotionText from "./MotionText.astro";

const content = site.productComesLater;
const leftFactors = content.factors.slice(0, 3);
const rightFactors = content.factors.slice(3);
---

<section
  id="visao"
  class="relative bg-paper-dark py-12 lg:py-16"
  aria-labelledby="product-title"
>
  <div class="pointer-events-none absolute inset-0 opacity-30" aria-hidden="true">
    <div class="technical-line top-0 left-[6%] h-full w-px"></div>
    <div class="technical-line top-0 right-[6%] h-full w-px hidden lg:block"></div>
  </div>

  <div class="content-container relative z-10">
    <SectionLabel text={content.eyebrow} />

    <h2
      id="product-title"
      class="mt-5 max-w-3xl font-display text-4xl font-light leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-6xl"
    >
      <MotionText as="span" class="block" type="reveal-line">
        {content.title}
      </MotionText>
    </h2>

    <MotionText as="p" class="mt-5 max-w-2xl text-base leading-relaxed text-graphite lg:mt-6 lg:text-lg" type="reveal">
      {content.text}
    </MotionText>

    <!-- Desktop: composição conectada -->
    <div class="decision-map relative mt-12 hidden lg:block">
      <div class="grid grid-cols-11 items-center gap-4">
        <!-- Coluna esquerda -->
        <div class="col-span-4 space-y-4">
          {leftFactors.map((factor, i) => (
            <div class="factor-node group border border-line bg-paper-light px-5 py-4 transition-colors hover:bg-white" data-motion="reveal">
              <div class="flex items-baseline gap-3">
                <span class="font-sans text-[10px] font-medium uppercase tracking-widest text-muted">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="font-display text-xl font-light text-ink">
                  {factor.label}
                </span>
              </div>
              <span class="mt-1 block pl-7 font-sans text-sm leading-relaxed text-muted">
                {factor.description}
              </span>
            </div>
          ))}
        </div>

        <!-- Centro: linhas e decisão -->
        <div class="col-span-3 flex flex-col items-center justify-center gap-3" aria-hidden="true">
          <div class="h-24 w-px bg-line"></div>
          <div class="flex w-full items-center">
            <div class="h-px flex-1 bg-line"></div>
            <div class="mx-2 h-2 w-2 bg-copper"></div>
            <div class="h-px flex-1 bg-line"></div>
          </div>
          <div class="h-12 w-px bg-line"></div>
          <div class="flex w-full items-center">
            <div class="h-px flex-1 bg-line"></div>
            <div class="mx-2 h-2 w-2 bg-copper"></div>
            <div class="h-px flex-1 bg-line"></div>
          </div>
          <div class="h-24 w-px bg-line"></div>
        </div>

        <!-- Coluna direita -->
        <div class="col-span-4 space-y-4">
          {rightFactors.map((factor, i) => (
            <div class="factor-node group border border-line bg-paper-light px-5 py-4 transition-colors hover:bg-white" data-motion="reveal">
              <div class="flex items-baseline gap-3">
                <span class="font-sans text-[10px] font-medium uppercase tracking-widest text-muted">
                  {String(i + 4).padStart(2, "0")}
                </span>
                <span class="font-display text-xl font-light text-ink">
                  {factor.label}
                </span>
              </div>
              <span class="mt-1 block pl-7 font-sans text-sm leading-relaxed text-muted">
                {factor.description}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Decisão central -->
      <div class="mx-auto mt-8 flex max-w-md flex-col items-center justify-center border border-ink bg-ink px-6 py-6 text-center" data-motion="reveal">
        <span class="font-sans text-[10px] font-medium uppercase tracking-widest text-copper-light">
          Decisão estruturada
        </span>
        <span class="mt-2 block font-display text-2xl font-light leading-snug text-white">
          Qual caminho faz sentido?
        </span>
      </div>
    </div>

    <!-- Mobile: sequência vertical conectada -->
    <div class="decision-map-mobile relative mt-8 block lg:hidden">
      <div class="relative space-y-0">
        <div class="absolute left-[15px] top-4 bottom-4 w-px bg-line" aria-hidden="true"></div>
        {content.factors.map((factor, i) => (
          <div class="factor-node relative pl-10 py-3" data-motion="reveal">
            <div class="absolute left-0 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center border border-line bg-paper-light">
              <span class="font-sans text-[10px] font-medium uppercase tracking-widest text-muted">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <div class="border-b border-line pb-3">
              <span class="font-display text-xl font-light text-ink">{factor.label}</span>
              <span class="mt-1 block font-sans text-sm leading-relaxed text-muted">{factor.description}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-2 border border-ink bg-ink px-5 py-5 text-center" data-motion="reveal">
        <span class="font-sans text-[10px] font-medium uppercase tracking-widest text-copper-light">
          Decisão estruturada
        </span>
        <span class="mt-2 block font-display text-xl font-light leading-snug text-white">
          Qual caminho faz sentido?
        </span>
      </div>
    </div>
  </div>
</section>
