---
import { site } from "../../data/site-content.js";
import SectionLabel from "./SectionLabel.astro";
import MotionText from "./MotionText.astro";

const content = site.method;
---

<section
  id="metodo"
  class="relative bg-paper-light py-20 lg:py-28"
  aria-labelledby="method-title"
>
  <div class="pointer-events-none absolute inset-0 opacity-30" aria-hidden="true">
    <div class="technical-line top-0 left-[6%] h-full w-px"></div>
    <div class="technical-line top-0 right-[6%] h-full w-px hidden lg:block"></div>
  </div>

  <div class="content-container relative z-10">
    <SectionLabel text={content.eyebrow} />

    <h2
      id="method-title"
      class="mt-6 max-w-3xl font-display text-4xl font-light leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-6xl"
    >
      <MotionText as="span" class="block" type="reveal-line">
        {content.title}
      </MotionText>
    </h2>

    <div class="method-track relative mt-14 lg:mt-20">
      <!-- Linha de progresso -->
      <div class="method-line pointer-events-none absolute left-[15px] top-0 bottom-0 w-px bg-line sm:left-[19px] lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></div>

      <div class="space-y-10 lg:space-y-16">
        {content.steps.map((step, i) => (
          <div
            class="method-step relative grid grid-cols-[auto_1fr] gap-6 sm:gap-8 lg:grid-cols-2 lg:gap-16"
            data-motion="reveal"
          >
            <!-- Marcador -->
            <div class="flex flex-col items-center lg:items-end">
              <div class="flex h-8 w-8 items-center justify-center border border-ink bg-ink text-white sm:h-10 sm:w-10">
                <span class="font-sans text-xs font-medium sm:text-sm">{String(i + 1).padStart(2, "0")}</span>
              </div>
            </div>

            <!-- Conteúdo -->
            <div class="lg:col-start-2">
              <h3 class="font-display text-2xl font-light text-ink sm:text-3xl">
                {step.title}
              </h3>
              <p class="mt-3 max-w-lg text-base leading-relaxed text-graphite lg:text-lg">
                {step.text}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
