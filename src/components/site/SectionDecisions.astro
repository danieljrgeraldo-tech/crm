---
import { site } from "../../data/site-content.js";
import SectionLabel from "./SectionLabel.astro";
import MotionText from "./MotionText.astro";

const content = site.decisions;
---

<section
  id="cenarios"
  class="relative bg-paper py-20 lg:py-28"
  aria-labelledby="decisions-title"
>
  <div class="pointer-events-none absolute inset-0 opacity-30" aria-hidden="true">
    <div class="technical-line top-0 left-[6%] h-full w-px"></div>
    <div class="technical-line top-0 right-[6%] h-full w-px hidden lg:block"></div>
  </div>

  <div class="content-container relative z-10">
    <SectionLabel text={content.eyebrow} />

    <h2
      id="decisions-title"
      class="mt-6 max-w-3xl font-display text-4xl font-light leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-6xl"
    >
      <MotionText as="span" class="block" type="reveal-line">
        {content.title}
      </MotionText>
    </h2>

    <div class="decision-list mt-12 border-t border-line lg:mt-16">
      {content.items.map((item, i) => (
        <details
          class="decision-item group border-b border-line"
          data-motion="reveal"
        >
          <summary class="flex cursor-pointer items-center justify-between py-6 transition-colors hover:bg-paper-light sm:py-7">
            <div class="flex items-baseline gap-4 pr-4 sm:gap-6">
              <span class="font-sans text-xs font-medium uppercase tracking-widest text-muted">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="font-display text-xl font-light text-ink sm:text-2xl lg:text-3xl">
                {item.title}
              </span>
            </div>
            <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center border border-line bg-paper-light transition-colors group-hover:border-ink group-open:bg-ink group-open:text-white" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" class="transition-transform group-open:rotate-45">
                <path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </span>
          </summary>
          <div class="pb-7 pl-10 sm:pl-14 lg:pl-16">
            <p class="max-w-2xl text-base leading-relaxed text-graphite lg:text-lg">
              {item.text}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
