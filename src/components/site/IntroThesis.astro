---
import { site } from "../../data/site-content.js";
import SectionLabel from "./SectionLabel.astro";
import MotionText from "./MotionText.astro";

const thesis = site.thesis;
---

<section
  id="visao"
  class="relative bg-paper-dark py-24 lg:py-32"
  aria-labelledby="thesis-title"
>
  <div class="pointer-events-none absolute inset-0 opacity-30" aria-hidden="true">
    <div class="technical-line top-0 left-[8%] h-full w-px"></div>
    <div class="technical-line top-0 right-[8%] h-full w-px hidden lg:block"></div>
  </div>

  <div class="content-container relative z-10">
    <SectionLabel text={thesis.label} />

    <h2
      id="thesis-title"
      class="mt-8 max-w-4xl font-display text-4xl font-light leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-6xl"
    >
      <MotionText as="span" class="block" type="reveal-line">
        {thesis.title}
      </MotionText>
    </h2>

    <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-20">
      <MotionText as="p" class="text-xl leading-relaxed text-graphite lg:text-2xl" type="reveal">
        {thesis.text}
      </MotionText>

      <MotionText as="p" class="text-lg leading-relaxed text-muted" type="reveal">
        {thesis.continuation}
      </MotionText>
    </div>

    <!-- Estrutura de fatores -->
    <div class="factor-grid mt-16 grid grid-cols-2 gap-px border border-line bg-line lg:grid-cols-3">
      {thesis.factors.map((factor, i) => (
        <div
          class="factor-item bg-paper-light px-6 py-8 transition-colors duration-300 hover:bg-white sm:px-8 sm:py-10"
          data-motion="reveal"
        >
          <span class="font-sans text-xs font-medium uppercase tracking-widest text-muted">
            0{i + 1}
          </span>
          <span class="mt-3 block font-display text-2xl font-light text-ink sm:text-3xl">
            {factor}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
