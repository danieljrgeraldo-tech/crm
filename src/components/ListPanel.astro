---
const { title = "Possibilidades", items } = Astro.props;
---

<div class="section-reveal rounded-lg border border-gold-300/18 bg-gold-300/[.045] p-5 sm:p-6">
  <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-gold-300">{title}</h3>
  <div class="mt-5 grid gap-3 sm:grid-cols-2">
    {items.map((item) => (
      <div class="flex min-h-12 items-center rounded-md border border-white/10 bg-black/22 px-4 py-3 text-sm font-medium text-white/82">
        {item}
      </div>
    ))}
  </div>
</div>
