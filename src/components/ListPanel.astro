---
const { title = "Possibilidades", items, tone = "dark" } = Astro.props;
const isLight = tone === "light";
---

<div class:list={[
  "section-reveal rounded-lg p-5 shadow-card sm:p-6",
  isLight ? "border border-gold-700/20 bg-white" : "border border-gold-300/18 bg-gold-300/[.045]"
]}>
  <h3 class:list={["text-sm font-semibold uppercase tracking-[0.2em]", isLight ? "text-gold-700" : "text-gold-300"]}>{title}</h3>
  <div class="mt-5 grid gap-3 sm:grid-cols-2">
    {items.map((item) => (
      <div class:list={[
        "check-row flex min-h-12 items-center gap-3 rounded-md px-4 py-3 text-sm font-semibold",
        isLight ? "border border-stone-200 bg-stone-50 text-stone-800" : "border border-white/10 bg-black/22 text-white/84"
      ]}>
        <span class="checkmark" aria-hidden="true"></span>
        <span>{item}</span>
      </div>
    ))}
  </div>
</div>
